diff --git a/osfmk/ipc/ipc_right.c b/osfmk/ipc/ipc_right.c
index 0d1ebf9..5896ca2 100644
--- a/osfmk/ipc/ipc_right.c
+++ b/osfmk/ipc/ipc_right.c
@@ -2355,7 +2355,23 @@ ipc_right_copyin(
