 		port = ip_object_to_port(entry->ie_object);
+#if defined(ARM64_BOARD_CONFIG_SWEET)
+		/*
+		 * evergo (0103e): v25 on-device died here during the teardown
+		 * storm - an ipc entry claimed SEND rights while its object was
+		 * already gone (freed-then-zeroed space, same corruption family
