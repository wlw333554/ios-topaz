+		 */
+		if (__improbable(port == IP_NULL)) {
+			printf("SWEET IPC: COPY_SEND on NULL port, entry %p name %u\n",
+			    entry, name);
+			goto invalid_right;
+		}
+#else
 		assert(port != IP_NULL);
+#endif
 
 		if (ipc_right_check(space, port, name, entry, IPC_OBJECT_COPYIN_FLAGS_NONE)) {
 			bits = entry->ie_bits;
