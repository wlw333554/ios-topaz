From 95f80cbf11ba304c78d0f4ec59f7b20e65478a81 Mon Sep 17 00:00:00 2001
From: x <x@x>
Date: Mon, 19 Oct 2026 12:32:46 +0300
Subject: [PATCH 902/947] topaz-0109: AMFI dyld policy answer;
 RedwoodWaitsForGPU

---
 bsd/kern/sweet_amfi.c                 | 48 +++++++++++++++++++--------
 iokit/Kernel/arm/SweetFramebuffer.cpp |  1 +
 2 files changed, 35 insertions(+), 14 deletions(-)

diff --git a/bsd/kern/sweet_amfi.c b/bsd/kern/sweet_amfi.c
index 9b86015..49ead96 100644
--- a/bsd/kern/sweet_amfi.c
+++ b/bsd/kern/sweet_amfi.c
@@ -332,23 +332,43 @@ sweet_sandbox_syscall(struct proc *p, int call, user_addr_t arg)
 }
 
 /*
- * __mac_syscall("AMFI", ...): libamfi asks AMFI by policy name, e.g.
- * amfi_interface_query_bootarg_state() in ExtensionFoundation; with no policy of that name it
- * fails and lsd's ExtensionKit says "Unable to find AMFI", so no app extension is registered
- * (PlugInKit -10814 for every extension point, PosterBoard has no wallpaper providers).
- * Every call succeeds and leaves the caller's output alone: no boot-arg flags, nothing special.
+ * topaz: dyld asks the policy named "AMFI" (__mac_syscall) what it may do for
+ * the process it starts. Without an answer it runs restricted and ignores the
+ * DYLD_* variables; allowing them lets a library of ours into backboardd
+ * (DYLD_INSERT_LIBRARIES in its launchd job: the GPU's OpenGL ES library).
+ * Argument: { u64 flags in, user pointer to u64 flags out }.
  */
+#define SWEET_AMFI_CHECK_DYLD_POLICY    0x5a
+#define SWEET_AMFI_DYLD_ALLOW_ALL       0xffULL
+
 static int
-sweet_amfi_syscall(struct proc *p __unused, int call, user_addr_t arg __unused)
+sweet_amfi_syscall(__unused struct proc *p, int call, user_addr_t arg)
 {
-	static uint64_t seen;
-	if (call >= 0 && call < 64 && !(seen & (1ULL << call))) {
-		seen |= 1ULL << call;
-		char name[32];
-		proc_selfname(name, sizeof(name));
-		printf("SWEET AMFI: syscall %d from %s\n", call, name);
+	uint64_t in_out[2] = { 0, 0 };
+	uint64_t allow = SWEET_AMFI_DYLD_ALLOW_ALL;
+	int error;
+
+	if (call != SWEET_AMFI_CHECK_DYLD_POLICY) {
+		/*
+		 * Everything else libamfi asks (amfi_interface_query_bootarg_state() in
+		 * ExtensionFoundation, ...) succeeds and leaves the caller's output alone. ENOSYS
+		 * made lsd's ExtensionKit say "Unable to find AMFI": no app extension got
+		 * registered (PlugInKit -10814 everywhere, PosterBoard had no wallpapers).
+		 */
+		static uint64_t seen;
+		if (call >= 0 && call < 64 && !(seen & (1ULL << call))) {
+			seen |= 1ULL << call;
+			char name[32];
+			proc_selfname(name, sizeof(name));
+			printf("SWEET AMFI: syscall %d from %s\n", call, name);
+		}
+		return 0;
 	}
-	return 0;
+	error = copyin(arg, in_out, sizeof(in_out));
+	if (error == 0) {
+		error = copyout(&allow, (user_addr_t)in_out[1], sizeof(allow));
+	}
+	return error;
 }
 
 static const struct mac_policy_ops sweet_amfi_mac_ops = {
@@ -407,7 +427,7 @@ static struct mac_policy_conf sweet_sandbox_mac_conf = {
 static mac_policy_handle_t sweet_sandbox_mac_handle;
 
 static struct mac_policy_conf sweet_amfi_mac_conf = {
-	.mpc_name = "AMFI",                    /* the name libamfi looks it up by */
+	.mpc_name = "AMFI",                     /* the name dyld's __mac_syscall uses */
 	.mpc_fullname = "SWEET built-in Mobile File Integrity",
 	.mpc_ops = &sweet_amfi_mac_ops,
 };
diff --git a/iokit/Kernel/arm/SweetFramebuffer.cpp b/iokit/Kernel/arm/SweetFramebuffer.cpp
index 1de36b2..de23813 100644
--- a/iokit/Kernel/arm/SweetFramebuffer.cpp
+++ b/iokit/Kernel/arm/SweetFramebuffer.cpp
@@ -314,6 +314,7 @@ AppleCLCD::start(IOService *provider)
 	fVig0 = (volatile uint32_t *)ml_io_map(0x05e05000, 0x1000);
 	fCtl0 = (volatile uint32_t *)ml_io_map(0x05e02000, 0x1000);
 	topaz_adreno_init();
+	setProperty("RedwoodWaitsForGPU", true);         /* present() waits for the GPU (eagl.c reads it) */
 	fDsi = (volatile uint8_t *)ml_io_map(0x05e94000, 0x1000);
 	fDsiBuf = IOBufferMemoryDescriptor::inTaskWithPhysicalMask(kernel_task,
 	    kIODirectionInOut | kIOMemoryPhysicallyContiguous, page_size, 0x00000000fffff000ull);
-- 
