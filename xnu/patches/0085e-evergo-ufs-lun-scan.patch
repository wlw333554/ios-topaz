From: evergo <evergo@localhost>
Subject: [PATCH 0085e] evergo: UFS scan LUNs for the GPT

Shim probe ground truth: LUN 0 and 1 are 4 MiB boot LUNs with
no GPT; the table with userdata is on LUN 2 (238 GiB, header at
LBA 1). Probe LUNs 0..7 with TEST UNIT READY and search each
for the wanted partition instead of hard-coding LUN 0.
---
diff --git a/bsd/dev/sweet_ufs.c b/bsd/dev/sweet_ufs.c
index 4f5c486..3cfb1f1 100644
--- a/bsd/dev/sweet_ufs.c
+++ b/bsd/dev/sweet_ufs.c
@@ -700,13 +700,29 @@ sweet_ufs_init(void)
 	lck_mtx_lock(&sweet_ufs_lock);
 	error = ufs_take_over_host();
 	if (!error) {
+		/*
+		 * evergo (measured with the shim probe): LUN 0 and 1 are 4 MiB
+		 * boot LUNs full of 0xff with no GPT; the partition table with
+		 * userdata is on LUN 2 (238 GiB, GPT header at LBA 1). Probe the
+		 * LUNs until the one holding the wanted partition turns up.
+		 */
 		static const uint8_t tur[6] = { 0x00 };
-		/* The first command after the bootloader may report a unit attention. */
-		for (int i = 0; i < 3 && (error = ufs_scsi(tur, sizeof(tur), 0, false)); i++) {
+		int terror = 0;
+		for (su.lun = 0; su.lun <= 7; su.lun++) {
+			/* A first command on a LUN may report a unit attention. */
+			for (int i = 0; i < 3 && (terror = ufs_scsi(tur, sizeof(tur), 0, false)); i++) {
+			}
+			if (terror) {
+				continue;	/* no such / not ready LUN */
+			}
+			error = ufs_find_partition(want);
+			if (!error) {
+				break;
+			}
+		}
+		if (su.lun > 7) {
+			su.lun = 0;
 		}
-	}
-	if (!error) {
-		error = ufs_find_partition(want);
 	}
 	lck_mtx_unlock(&sweet_ufs_lock);
 	if (error) {
