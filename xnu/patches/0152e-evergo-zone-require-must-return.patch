From f0152e0000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
Subject: [PATCH 0152e] evergo: zone_require_panic must actually return (v2, correct base)

0151e was generated against the stale _bt65 tree. CI's dxb/build.sh
SILENTLY SKIPS patches whose anchors do not match, so 0151e never applied:
the resulting kernel still had

    _zone_require_panic + 0x100:
        0x7ab5590  bl printf   (SWEET ZONE: ... - continuing)
        0x7ab5594  brk #1      <-- device dies here

`__abortlike` expands to `__dead2 __cold __not_tail_called`; `__dead2` is
noreturn. 0143e put `return;` inside this noreturn function, so the compiler
ignored it and appended `__builtin_unreachable()` -> brk. The diagnostic
printed, then the boot died one instruction later.

This patch is generated against the ACTUAL post-0143e buildtree (zalloc.c
with the SWEET ZONE printf). It:
  - removes __abortlike from zone_require_panic under SWEET,
  - converts ALL THREE panic branches to report-and-return under SWEET
    (0143e only converted the first).
---
diff --git a/osfmk/kern/zalloc.c b/osfmk/kern/zalloc.c
index 4034f97..c69f1ec 100644
--- a/osfmk/kern/zalloc.c
+++ b/osfmk/kern/zalloc.c
@@ -1411,7 +1411,9 @@ zone_id_for_element(void *addr, vm_size_t esize)
 }
 
 /* This function just formats the reason for the panics by redoing the checks */
+#if !defined(ARM64_BOARD_CONFIG_SWEET) && !defined(SWEET)
 __abortlike
+#endif
 static void
 zone_require_panic(zone_t zone, void *addr)
 {
@@ -1421,11 +1423,11 @@ zone_require_panic(zone_t zone, void *addr)
 	if (!from_zone_map(addr, zone_elem_inner_size(zone))) {
 #if defined(ARM64_BOARD_CONFIG_SWEET) || defined(SWEET)
 		/*
-		 * evergo (0143e): with the read-only zone allocator compiled out
-		 * (0124e) this check is a diagnostic, not a security boundary.
-		 * v67 hit it with addr 0xffffffffff8080 - not even a kernel
-		 * pointer - while a crashed daemon was being torn down.  Report
-		 * and continue instead of losing the boot.
+		 * evergo (0143e/0152e): with the read-only zone allocator compiled
+		 * out (0124e) this check is a diagnostic, not a security boundary.
+		 * 0143e already printed here but the function was __abortlike
+		 * (noreturn), so the compiler appended a BRK right after printf and
+		 * the device still died - see 0152e's header for the disassembly.
 		 */
 		static void *last_bad;
 		if (last_bad != addr) {
@@ -1443,14 +1445,38 @@ zone_require_panic(zone_t zone, void *addr)
 	zindex = zone_index_from_ptr(addr);
 	other = &zone_array[zindex];
 	if (zindex >= os_atomic_load(&num_zones, relaxed) || !other->z_self) {
+#if defined(ARM64_BOARD_CONFIG_SWEET) || defined(SWEET)
+		/* evergo (0152e): diagnostic only - report, do not die. */
+		static uint32_t last_zindex;
+		if (last_zindex != zindex) {
+			last_zindex = zindex;
+			printf("SWEET ZONE: require(%s) invalid zone index %d "
+			    "(addr %p) - continuing\n",
+			    zone->z_name, zindex, addr);
+		}
+		return;
+#else
 		panic("zone_require failed: invalid zone index %d "
 		    "(addr: %p, expected: %s%s)", zindex,
 		    addr, zone_heap_name(zone), zone->z_name);
+#endif
 	} else {
+#if defined(ARM64_BOARD_CONFIG_SWEET) || defined(SWEET)
+		/* evergo (0152e): a wrong zone is worth a line, not a boot. */
+		static void *last_wrong;
+		if (last_wrong != addr) {
+			last_wrong = addr;
+			printf("SWEET ZONE: require(%s) wrong zone %d (%s%s) "
+			    "addr %p - continuing\n", zone->z_name, zindex,
+			    zone_heap_name(other), other->z_name, addr);
+		}
+		return;
+#else
 		panic("zone_require failed: address in unexpected zone id %d (%s%s) "
 		    "(addr: %p, expected: %s%s)",
 		    zindex, zone_heap_name(other), other->z_name,
 		    addr, zone_heap_name(zone), zone->z_name);
+#endif
 	}
 }
 
