From 3ac0767bfb3e0f05b31b8269027171fee1f78ce1 Mon Sep 17 00:00:00 2001
From: x <x@x>
Date: Mon, 19 Oct 2026 15:56:06 +0300
Subject: [PATCH 914/947] topaz-0122: log whether backboardd gets
 DYLD_INSERT_LIBRARIES

---
 bsd/kern/kern_exec.c | 10 ++++++++++
 1 file changed, 10 insertions(+)

diff --git a/bsd/kern/kern_exec.c b/bsd/kern/kern_exec.c
index 68612db..60b894a 100644
--- a/bsd/kern/kern_exec.c
+++ b/bsd/kern/kern_exec.c
@@ -7414,6 +7414,16 @@ process_signature(proc_t p, struct image_params *imgp)
 #if defined(ARM64_BOARD_CONFIG_SWEET)
 			/* SWEET runs every iOS binary this way: one short line per exec. */
 			printf("exec %s\n", p->p_name);
+			/* topaz: does the window server get our library (GPU's OpenGL ES)? */
+			if (strcmp(p->p_name, "backboardd") == 0 && imgp->ip_endargv != NULL && imgp->ip_endenvv != NULL) {
+				const char *e = imgp->ip_endargv, *end = imgp->ip_endenvv;
+				bool found = false;
+				while (e < end && !found) {
+					found = strncmp(e, "DYLD_INSERT_LIBRARIES=", 22) == 0;
+					e += strnlen(e, (size_t)(end - e)) + 1;
+				}
+				printf("topaz: backboardd starts %s DYLD_INSERT_LIBRARIES\n", found ? "WITH" : "without");
+			}
 #else
 			printf("Allowing spawn of iOS binary %s since it has "
 			    "com.apple.private.security.no-sandbox entitlement or unentitled_ios_sim_launch "
-- 
