@@ -1841,7 +1851,7 @@ vm_shared_region_map_file_setup(
 					map_port,
 					mappings[i].sms_file_offset,
 					TRUE,
-					mappings[i].sms_init_prot & VM_PROT_ALL,
+					evergo_init_prot,
 					evergo_max_prot,
 					VM_INHERIT_DEFAULT);
 			}
