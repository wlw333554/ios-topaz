+			 * private copy (text pages are never written, so sharing
+			 * stays intact), which removes the whole fault class.
 			 */
 			evergo_max_prot = (mappings[i].sms_max_prot | VM_PROT_WRITE) & VM_PROT_ALL;
+			evergo_init_prot = (mappings[i].sms_init_prot | VM_PROT_WRITE) & VM_PROT_ALL;
 
