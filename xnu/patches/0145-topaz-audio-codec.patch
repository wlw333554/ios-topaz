diff --git a/iokit/Kernel/arm/TopazRpm.cpp b/iokit/Kernel/arm/TopazRpm.cpp
new file mode 100644
index 0000000..419835e
--- /dev/null
+++ b/iokit/Kernel/arm/TopazRpm.cpp
@@ -0,0 +1,330 @@
+/*
+ * topaz (SM6225): requests to the RPM (resource power manager), which owns the rails and
+ * clocks the AP votes for. Port of MakrSas/topaz-woa drivers/TopazRpm: GLINK over the RPM
+ * message RAM (0x045F0000 + 0x7000, Linux qcom_glink_rpm.c: TOC "grt0" at the end, FIFOs
+ * "ap2r" / "r2ap" of {tail, head, data}), doorbell APCS IPC bit 0, channel "rpm_requests",
+ * qcom_smd-rpm.c messages {"req", len} {msg id, set, type, id, len} {key, 4, value}.
+ * Word accesses only (the message RAM is device memory). Polled.
+ * Lesson from Windows: a second GLINK handshake on a link already used since boot crashed the
+ * RPM and took the SoC down, so the link is brought up once per boot and only if both FIFOs
+ * are untouched.
+ */
+#include <pexpert/arm64/board_config.h>
+
+#if defined(SWEET)
+#include <IOKit/IOLib.h>
+#include <sys/param.h>
+
+#define LOG(fmt, ...)       IOLog("TopazRpm: " fmt "\n", ##__VA_ARGS__)
+
+extern "C" vm_offset_t ml_io_map(vm_offset_t phys_addr, vm_size_t size);
+extern "C" void topaz_apcs_kick(unsigned bit);
+
+#define MSG_RAM_PA          0x045F0000ull
+#define MSG_RAM_SIZE        0x7000u
+#define TOC_SIZE            256u
+#define TOC_MAGIC           0x67727430u     /* "grt0" */
+#define FIFO_AP2R           0x61703272u     /* "ap2r" */
+#define FIFO_R2AP           0x72326170u     /* "r2ap" */
+#define RPM_IPC_BIT         0
+
+enum { CMD_VERSION = 0, CMD_VERSION_ACK = 1, CMD_OPEN = 2, CMD_CLOSE = 3, CMD_OPEN_ACK = 4, CMD_TX_DATA = 9,
+       CMD_CLOSE_ACK = 11, CMD_TX_DATA_CONT = 12, CMD_READ_NOTIF = 13, CMD_SIGNALS = 15 };
+
+#define CHAN_NAME           "rpm_requests"
+#define CHAN_LCID           1
+#define RPM_SERVICE_REQ     0x00716572u     /* "req" */
+#define RPM_MSG_ID          0x2367736Du     /* "msg#" */
+#define RPM_MSG_ERR         0x00727265u     /* "err" */
+
+static volatile uint8_t *ram;
+static uint32_t tx_off, tx_size, rx_off, rx_size;
+static bool version_done, open_ack, remote_open, last_err, link_up, link_failed;
+static uint32_t msg_id;
+static int32_t last_ack = -1;
+static IOLock *rpm_lock;
+
+static inline uint32_t rd(uint32_t o) { return *(volatile uint32_t *)(ram + o); }
+static inline void wr(uint32_t o, uint32_t v) { __asm__ volatile ("dsb sy" ::: "memory"); *(volatile uint32_t *)(ram + o) = v; }
+
+/* len a multiple of 8 */
+static bool
+tx_send(const void *msg, uint32_t len)
+{
+	uint32_t tail = rd(tx_off), head = rd(tx_off + 4);
+	uint32_t avail = tail <= head ? tx_size - head + tail : tail - head;
+
+	if ((len & 7) != 0 || avail <= len) {
+		LOG("tx: no room (%u bytes, head %x tail %x)", len, head, tail);
+		return false;
+	}
+	for (uint32_t i = 0; i < len; i += 4) {
+		wr(tx_off + 8 + head, *(const uint32_t *)((const uint8_t *)msg + i));
+		head += 4;
+		if (head >= tx_size) {
+			head -= tx_size;
+		}
+	}
+	wr(tx_off + 4, head);
+	topaz_apcs_kick(RPM_IPC_BIT);
+	return true;
+}
+
+static void
+send_cmd(uint16_t cmd, uint16_t p1, uint32_t p2)
+{
+	uint32_t m[2] = { (uint32_t)cmd | ((uint32_t)p1 << 16), p2 };
+	tx_send(m, sizeof(m));
+}
+
+static uint32_t
+rx_avail(void)
+{
+	uint32_t tail = rd(rx_off), head = rd(rx_off + 4);
+	return head >= tail ? head - tail : rx_size - tail + head;
+}
+
+static void
+rx_peek(uint32_t at, void *dst, uint32_t len)
+{
+	uint32_t tail = rd(rx_off);
+	for (uint32_t i = 0; i < len; i += 4) {
+		*(uint32_t *)((uint8_t *)dst + i) = rd(rx_off + 8 + (tail + at + i) % rx_size);
+	}
+}
+
+static void
+rx_advance(uint32_t len)
+{
+	uint32_t tail = rd(rx_off) + len;
+	if (tail >= rx_size) {
+		tail -= rx_size;
+	}
+	wr(rx_off, tail);
+}
+
+static void
+rpm_reply(const uint8_t *p, uint32_t len)
+{
+	uint32_t o = 8;
+
+	if (len < 8 || *(const uint32_t *)p != RPM_SERVICE_REQ) {
+		LOG("unexpected reply, %u bytes", len);
+		return;
+	}
+	while (o + 8 <= len) {
+		uint32_t type = *(const uint32_t *)(p + o), l = *(const uint32_t *)(p + o + 4);
+		if (type == RPM_MSG_ID && l >= 4 && o + 12 <= len) {
+			last_ack = (int32_t)*(const uint32_t *)(p + o + 8);
+		} else if (type == RPM_MSG_ERR) {
+			char e[64];
+			uint32_t n = MIN(MIN(l, (uint32_t)sizeof(e) - 1), len - o - 8);
+			memcpy(e, p + o + 8, n);
+			e[n] = 0;
+			last_err = true;
+			LOG("RPM error \"%s\"", e);
+		}
+		o += 8 + ((l + 3) & ~3u);
+	}
+}
+
+static bool
+rx_one(void)
+{
+	uint32_t avail = rx_avail(), m[2], n;
+
+	if (avail < 8) {
+		return false;
+	}
+	rx_peek(0, m, 8);
+	uint16_t cmd = (uint16_t)m[0], p1 = (uint16_t)(m[0] >> 16);
+	switch (cmd) {
+	case CMD_VERSION:
+		rx_advance(8);
+		send_cmd(CMD_VERSION_ACK, 1, 0);
+		version_done = true;
+		break;
+	case CMD_VERSION_ACK:
+		rx_advance(8);
+		version_done = true;
+		break;
+	case CMD_OPEN: {
+		char name[36];
+		n = (8 + m[1] + 7) & ~7u;
+		if (avail < n || m[1] > 32) {
+			return false;
+		}
+		bzero(name, sizeof(name));
+		rx_peek(8, name, (m[1] + 3) & ~3u);
+		rx_advance(n);
+		LOG("RPM OPEN \"%s\" rcid %u", name, p1);
+		if (strcmp(name, CHAN_NAME) == 0) {
+			remote_open = true;
+			send_cmd(CMD_OPEN_ACK, p1, 0);
+		}
+		break;
+	}
+	case CMD_OPEN_ACK:
+		rx_advance(8);
+		open_ack = p1 == CHAN_LCID;
+		break;
+	case CMD_TX_DATA:
+	case CMD_TX_DATA_CONT: {
+		uint32_t c[2];
+		uint8_t buf[256];
+		if (avail < 16) {
+			return false;
+		}
+		rx_peek(8, c, 8);                       /* chunk_size, left_size */
+		n = (16 + c[0] + 7) & ~7u;
+		if (avail < n) {
+			return false;
+		}
+		if (c[0] <= sizeof(buf)) {
+			rx_peek(16, buf, (c[0] + 3) & ~3u);
+			rpm_reply(buf, c[0]);
+		}
+		rx_advance(n);
+		break;
+	}
+	case CMD_CLOSE:
+		rx_advance(8);
+		send_cmd(CMD_CLOSE_ACK, p1, 0);
+		remote_open = false;
+		break;
+	case CMD_CLOSE_ACK:
+	case CMD_READ_NOTIF:
+	case CMD_SIGNALS:
+		rx_advance(8);
+		break;
+	default:
+		LOG("unknown cmd %u, dropping the FIFO", cmd);
+		rx_advance(avail);
+		break;
+	}
+	return true;
+}
+
+static bool
+wait_for(bool (*done)(void), unsigned ms)
+{
+	for (unsigned t = 0; t <= ms; t++) {
+		while (rx_one()) {
+		}
+		if (done()) {
+			return true;
+		}
+		IOSleep(1);
+	}
+	return false;
+}
+
+static bool is_version(void) { return version_done; }
+static bool is_open(void) { return open_ack && remote_open; }
+static bool is_answered(void) { return last_ack == (int32_t)msg_id || last_err; }
+
+static bool
+link(void)
+{
+	uint32_t toc = MSG_RAM_SIZE - TOC_SIZE;
+
+	ram = (volatile uint8_t *)ml_io_map(MSG_RAM_PA, MSG_RAM_SIZE);
+	if (ram == NULL || rd(toc) != TOC_MAGIC || rd(toc + 4) > (TOC_SIZE - 8) / 12) {
+		LOG("message RAM: no TOC");
+		return false;
+	}
+	for (uint32_t i = 0; i < rd(toc + 4); i++) {
+		uint32_t id = rd(toc + 8 + 12 * i), off = rd(toc + 12 + 12 * i), size = rd(toc + 16 + 12 * i);
+		if (off + 8 + size > MSG_RAM_SIZE) {
+			continue;
+		}
+		if (id == FIFO_AP2R) {
+			tx_off = off;
+			tx_size = size;
+		} else if (id == FIFO_R2AP) {
+			rx_off = off;
+			rx_size = size;
+		}
+	}
+	if (tx_size == 0 || rx_size == 0) {
+		LOG("no ap2r/r2ap FIFO in the TOC");
+		return false;
+	}
+	if (rd(tx_off) != 0 || rd(tx_off + 4) != 0 || rd(rx_off) != 0 || rd(rx_off + 4) != 0) {
+		LOG("FIFOs used since boot: no second handshake (it crashed the RPM on Windows)");
+		return false;
+	}
+	send_cmd(CMD_VERSION, 1, 0);
+	if (!wait_for(is_version, 1000)) {
+		LOG("no VERSION answer");
+		return false;
+	}
+	struct { uint32_t hdr[2]; char name[16]; } open;
+	bzero(&open, sizeof(open));
+	open.hdr[0] = CMD_OPEN | ((uint32_t)CHAN_LCID << 16);
+	open.hdr[1] = sizeof(CHAN_NAME);
+	memcpy(open.name, CHAN_NAME, sizeof(CHAN_NAME));
+	tx_send(&open, sizeof(open));
+	if (!wait_for(is_open, 1000)) {
+		LOG("rpm_requests not open (ack %u remote %u)", open_ack, remote_open);
+		return false;
+	}
+	LOG("rpm_requests open");
+	return true;
+}
+
+/*
+ * One key/value request (qcom_rpm_smd_write) in set 0 (active) or 1 (sleep). Returns true if
+ * the RPM acked it without an error. The first call brings the link up (once per boot).
+ */
+extern "C" bool
+topaz_rpm_write(uint32_t set, uint32_t type, uint32_t id, uint32_t key, uint32_t value)
+{
+	struct {
+		uint16_t cmd, lcid; uint32_t iid; uint32_t chunk, left;    /* glink TX_DATA */
+		uint32_t service, length;                               /* qcom_rpm_header */
+		uint32_t msg_id, flags, type, id, data_len;             /* qcom_rpm_request */
+		uint32_t key, key_len, value;
+	} __attribute__((packed)) m;
+	bool ok;
+
+	if (rpm_lock == NULL) {
+		IOLock *l = IOLockAlloc();
+		if (!OSCompareAndSwapPtr(NULL, l, (void * volatile *)&rpm_lock)) {
+			IOLockFree(l);
+		}
+	}
+	IOLockLock(rpm_lock);
+	if (!link_up && !link_failed) {
+		link_up = link();
+		link_failed = !link_up;
+	}
+	if (!link_up) {
+		IOLockUnlock(rpm_lock);
+		return false;
+	}
+	bzero(&m, sizeof(m));
+	msg_id++;
+	last_err = false;
+	m.cmd = CMD_TX_DATA;
+	m.lcid = CHAN_LCID;
+	m.chunk = 8 + 20 + 12;
+	m.service = RPM_SERVICE_REQ;
+	m.length = 20 + 12;
+	m.msg_id = msg_id;
+	m.flags = set;
+	m.type = type;
+	m.id = id;
+	m.data_len = 12;
+	m.key = key;
+	m.key_len = 4;
+	m.value = value;
+	static_assert(sizeof(m) == 56, "rpm message");
+	ok = tx_send(&m, sizeof(m)) && wait_for(is_answered, 1000) && !last_err;
+	IOLockUnlock(rpm_lock);
+	return ok;
+}
+
+#else
+extern "C" bool topaz_rpm_write(uint32_t, uint32_t, uint32_t, uint32_t, uint32_t) { return false; }
+#endif
