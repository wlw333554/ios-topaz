From 4bcfe4a6b2d4c10848e57f8527e5f6b129eb1c40 Mon Sep 17 00:00:00 2001
From: x <x@x>
Date: Wed, 21 Oct 2026 01:45:11 +0300
Subject: [PATCH 934/947] topaz private: client-memory surfaces shared with the
 GPU only when contiguous over their whole range and page-aligned (4 KiB
 pages: garbage in text)

---
 iokit/Kernel/arm/RedwoodGPU.cpp | 9 ++++++++-
 1 file changed, 8 insertions(+), 1 deletion(-)

diff --git a/iokit/Kernel/arm/RedwoodGPU.cpp b/iokit/Kernel/arm/RedwoodGPU.cpp
index edc0555..4d32071 100644
--- a/iokit/Kernel/arm/RedwoodGPU.cpp
+++ b/iokit/Kernel/arm/RedwoodGPU.cpp
@@ -879,7 +879,14 @@ RedwoodGPUUserClient::surfaceBuffer(struct redwood_surface * request)
 	if (redwood_gpu_identity()) {
 		IOByteCount length = 0;
 		addr64_t phys = s->memory->getPhysicalSegment(0, &length, kIOMemoryMapperNone);
-		if (phys == 0 || length < s->allocSize || phys + s->allocSize > (1ull << 32)) {
+		/*
+		 * Client memory starts wrapDelta into its first page and the buffer starts at the
+		 * page: the whole range must be contiguous, and a nonzero delta is not shared at all
+		 * (the GPU would read the picture from the page start). With 4 KiB pages a run past
+		 * allocSize was often someone else's page: garbage in text textures.
+		 */
+		uint64_t need = s->wrapped ? s->memory->getLength() : s->allocSize;
+		if (phys == 0 || length < need || phys + need > (1ull << 32) || (s->wrapped && s->wrapDelta != 0)) {
 			static uint32_t told;
 			if (told++ < 16) {
 				IOLog("RedwoodGPU: surface %u (%ux%u, %u bytes) not shared: phys %#llx, contiguous %llu bytes, "
-- 
