From a538f5ab7c9b1aca009361982049f3b430983f3f Mon Sep 17 00:00:00 2001
From: x <x@x>
Date: Mon, 19 Oct 2026 15:04:58 +0300
Subject: [PATCH 910/947] topaz-0118: Mesa buffers from the GPU pool in
 pass-through mode

---
 iokit/Kernel/arm/RedwoodGPU.cpp  |  58 ++++++++++++++--
 iokit/Kernel/arm/TopazAdreno.cpp | 111 ++++++++++++++++++++++++++++---
 2 files changed, 156 insertions(+), 13 deletions(-)

diff --git a/iokit/Kernel/arm/RedwoodGPU.cpp b/iokit/Kernel/arm/RedwoodGPU.cpp
index 969a669..3278d07 100644
--- a/iokit/Kernel/arm/RedwoodGPU.cpp
+++ b/iokit/Kernel/arm/RedwoodGPU.cpp
@@ -51,6 +51,8 @@ bool topaz_surface_drawn(SweetSurface * surface, uint64_t milliseconds);
 extern "C" {
 /* bsd/dev/redwood_adreno.c ("the GPU kept on"; declared in bsd/sys/redwood_input.h, which is not seen from here) */
 bool redwood_gpu_ready(void);
+bool redwood_gpu_identity(void);
+uint64_t topaz_gpu_pool_alloc(uint64_t size, void ** va);
 bool redwood_gpu_parameter(uint32_t which, uint64_t * value);
 uint64_t redwood_gpu_address(uint64_t size);
 void redwood_gpu_address_free(uint64_t address, uint64_t size);
@@ -321,7 +323,7 @@ RedwoodGPUStart(void)
 
 	/* topaz: buffers are ordinary cached memory by default (gpu_cached=0 asks for write-combined,
 	 * which IOBMD makes contiguous, from the lower DDR bank the kernel cannot map back) */
-	cached = 1;
+	cached = redwood_gpu_identity() ? 0 : 1;        /* pool memory is write-combined already */
 	(void)PE_parse_boot_argn("gpu_cached", &cached, sizeof(cached));
 	gGPUCached = cached != 0;
 	gGPULock = IOLockAlloc();
@@ -615,11 +617,23 @@ RedwoodGPUUserClient::newBuffer(IOMemoryDescriptor * memory, uint64_t from, uint
 			break;
 		}
 	}
-	if (b == NULL || (b->address = redwood_gpu_address(size)) == 0) {
+	if (b != NULL && redwood_gpu_identity()) {
+		/* topaz: the SMMU passes addresses through: the GPU's address is the physical one */
+		IOByteCount length = 0;
+		addr64_t phys = memory->getPhysicalSegment(from, &length, kIOMemoryMapperNone);
+
+		if (phys == 0 || length < size || phys + size > (1ull << 32)) {
+			IOLog("RedwoodGPU: a buffer of %llu bytes the GPU cannot address (%#llx, %llu contiguous)\n", size, phys,
+			    (uint64_t) length);
+			return NULL;
+		}
+		b->address = phys;
+		mapped = true;
+	} else if (b == NULL || (b->address = redwood_gpu_address(size)) == 0) {
 		IOLog("RedwoodGPU: no %s left for a buffer of %llu bytes\n", b ? "addresses" : "handles", size);
 		return NULL;
 	}
-	for (uint64_t offset = 0; offset < size && mapped; offset += 4096) {
+	for (uint64_t offset = 0; offset < size && mapped && !redwood_gpu_identity(); offset += 4096) {
 		IOByteCount length = 0;
 		addr64_t phys = memory->getPhysicalSegment(from + offset, &length, kIOMemoryMapperNone);
 
@@ -750,6 +764,33 @@ RedwoodGPUUserClient::gemNew(struct msm_gem_new * request)
 	}
 	IOLockUnlock(gGPULock);
 	/* (the memory comes zeroed, and making it write-combined pushes the zeroes out of the cache) */
+	if (redwood_gpu_identity()) {
+		/* topaz: from the GPU's pool below 4 GiB (contiguous, write-combined) */
+		void * va = NULL;
+		uint64_t pa = topaz_gpu_pool_alloc(size, &va);
+
+		if (pa == 0) {
+			IOLog("RedwoodGPU: the GPU pool has no %llu bytes left\n", size);
+			return kIOReturnNoMemory;
+		}
+		bzero(va, (size_t) size);
+		IOMemoryDescriptor * pm = IOMemoryDescriptor::withPhysicalAddress(pa, size, kIODirectionInOut);
+		IOLockLock(gGPULock);
+		b = pm != NULL ? newBuffer(pm, 0, size, request->flags, &request->handle) : NULL;
+		if (b != NULL) {
+			b->memory = pm;
+			b->kernel = (uint8_t *) va;
+			gGPUStat.made++;
+		} else {
+			redwood_gpu_address_free(pa, size);     /* back to the pool */
+		}
+		IOLockUnlock(gGPULock);
+		if (b == NULL) {
+			OSSafeReleaseNULL(pm);
+			return kIOReturnNoMemory;
+		}
+		return kIOReturnSuccess;
+	}
 	memory = IOBufferMemoryDescriptor::inTaskWithOptions(kernel_task, kIODirectionInOut | kIOMemoryKernelUserShared |
 	    (gGPUCached ? 0 : kIOMapWriteCombineCache), (vm_size_t) size, PAGE_SIZE);
 	if (memory == NULL) {
@@ -799,6 +840,14 @@ RedwoodGPUUserClient::surfaceBuffer(struct redwood_surface * request)
 		s->release();
 		return kIOReturnUnsupported;
 	}
+	if (redwood_gpu_identity()) {
+		IOByteCount length = 0;
+		addr64_t phys = s->memory->getPhysicalSegment(0, &length, kIOMemoryMapperNone);
+		if (phys == 0 || length < s->allocSize || phys + s->allocSize > (1ull << 32)) {
+			s->release();
+			return kIOReturnUnsupported;    /* (eagl.c then fills a texture from it and reads frames back) */
+		}
+	}
 	size = round_page_64(s->allocSize);
 	memory = IOSubMemoryDescriptor::withSubRange(s->memory, 0, size, kIODirectionInOut);
 	if (memory == NULL || size == 0 || size > GPU_BUFFER_MAX) {
@@ -1074,7 +1123,8 @@ RedwoodGPUUserClient::clientMemoryForType(UInt32 type, IOOptionBits * options, I
 		b->memory->retain();
 		b->seen = true;
 		*memory = b->memory;
-		*options = 0;
+		/* topaz: pool memory is not the kernel's: mapped write-combined, not as a device */
+		*options = redwood_gpu_identity() ? kIOMapWriteCombineCache : 0;
 		ret = kIOReturnSuccess;
 	}
 	IOLockUnlock(gGPULock);
diff --git a/iokit/Kernel/arm/TopazAdreno.cpp b/iokit/Kernel/arm/TopazAdreno.cpp
index 940b37f..f19d9f5 100644
--- a/iokit/Kernel/arm/TopazAdreno.cpp
+++ b/iokit/Kernel/arm/TopazAdreno.cpp
@@ -160,25 +160,101 @@ kbuf_pa(struct kbuf *b, uint64_t off)
  * the GPU's, mapped write-combined (Normal non-cacheable: no cache upkeep).
  */
 #define GPU_POOL_BASE       0x90000000ull
-#define GPU_POOL_SIZE       0x20000000ull       /* 512 MB */
-static uint64_t gpu_pool_next = GPU_POOL_BASE;
+#define GPU_POOL_SIZE       0x40000000ull       /* 1 GB */
+#define GPU_POOL_UNIT       0x10000ull          /* 64 KB */
+static uint8_t *gpu_pool_va;                    /* the whole pool, mapped once, write-combined */
+static struct { uint64_t start, size; } pool_free[2048];
+static unsigned pool_free_count;
+
+static void
+range_free(void *table, unsigned *count, unsigned max, uint64_t address, uint64_t size)
+{
+	struct r { uint64_t start, size; } *f = (struct r *)table;
+	unsigned at;
+
+	for (at = 0; at < *count && f[at].start < address; at++) {
+	}
+	if (at > 0 && f[at - 1].start + f[at - 1].size == address) {
+		f[at - 1].size += size;
+		if (at < *count && address + size == f[at].start) {
+			f[at - 1].size += f[at].size;
+			memmove(&f[at], &f[at + 1], (--*count - at) * sizeof(f[0]));
+		}
+	} else if (at < *count && address + size == f[at].start) {
+		f[at].start = address;
+		f[at].size += size;
+	} else if (*count < max) {
+		memmove(&f[at + 1], &f[at], (*count - at) * sizeof(f[0]));
+		(*count)++;
+		f[at].start = address;
+		f[at].size = size;
+	}
+}
+
+static uint64_t
+range_alloc(void *table, unsigned *count, uint64_t size)
+{
+	struct r { uint64_t start, size; } *f = (struct r *)table;
+
+	for (unsigned i = 0; i < *count; i++) {
+		if (f[i].size >= size) {
+			uint64_t address = f[i].start;
+			f[i].start += size;
+			f[i].size -= size;
+			if (f[i].size == 0) {
+				memmove(&f[i], &f[i + 1], (--*count - i) * sizeof(f[0]));
+			}
+			return address;
+		}
+	}
+	return 0;
+}
+
+/* Contiguous GPU memory below 4 GiB: physical address, kernel address (write-combined). 0: none left. */
+extern "C" uint64_t topaz_gpu_pool_alloc(uint64_t size, void **va);
+uint64_t
+topaz_gpu_pool_alloc(uint64_t size, void **va)
+{
+	uint64_t pa;
+
+	size = (size + GPU_POOL_UNIT - 1) & ~(GPU_POOL_UNIT - 1);
+	if (gpu_pool_va == NULL) {
+		gpu_pool_va = (uint8_t *)ml_io_map_wcomb((vm_offset_t)GPU_POOL_BASE, (vm_size_t)GPU_POOL_SIZE);
+		if (gpu_pool_va == NULL) {
+			return 0;
+		}
+		range_free(pool_free, &pool_free_count, 2048, GPU_POOL_BASE, GPU_POOL_SIZE);
+	}
+	pa = range_alloc(pool_free, &pool_free_count, size);
+	if (pa != 0 && va != NULL) {
+		*va = gpu_pool_va + (pa - GPU_POOL_BASE);
+	}
+	return pa;
+}
+
+static void
+pool_give_back(uint64_t pa, uint64_t size)
+{
+	size = (size + GPU_POOL_UNIT - 1) & ~(GPU_POOL_UNIT - 1);
+	if (pa >= GPU_POOL_BASE && pa + size <= GPU_POOL_BASE + GPU_POOL_SIZE) {
+		range_free(pool_free, &pool_free_count, 2048, pa, size);
+	}
+}
 /* boot-arg gpu_identity (default 1): the SMMU passes addresses through (TopazGpuW G1), GPU VA = PA */
 static uint32_t gpu_identity = 1;
 
 static bool
 kbuf_alloc_low(struct kbuf *b, uint64_t size)
 {
+	void *va = NULL;
+
 	size = (size + PAGE_SIZE - 1) & ~(uint64_t)(PAGE_SIZE - 1);
-	if (gpu_pool_next + size > GPU_POOL_BASE + GPU_POOL_SIZE) {
-		return false;
-	}
 	b->md = NULL;
-	b->pa = gpu_pool_next;
-	b->va = (uint8_t *)ml_io_map_wcomb((vm_offset_t)b->pa, (vm_size_t)size);
-	if (b->va == NULL) {
+	b->pa = topaz_gpu_pool_alloc(size, &va);
+	if (b->pa == 0) {
 		return false;
 	}
-	gpu_pool_next += size;
+	b->va = (uint8_t *)va;
 	b->size = size;
 	for (uint64_t i = 0; i < size; i += 8) {
 		*(volatile uint64_t *)(b->va + i) = 0;
@@ -552,6 +628,13 @@ kbuf_map(struct kbuf *b)
 static struct { uint64_t start, size; } va_free[1024];
 static unsigned va_free_count;
 
+extern "C" bool redwood_gpu_identity(void);
+bool
+redwood_gpu_identity(void)
+{
+	return gpu_identity != 0;
+}
+
 uint64_t
 redwood_gpu_address(uint64_t size)
 {
@@ -575,6 +658,10 @@ redwood_gpu_address_free(uint64_t address, uint64_t size)
 {
 	unsigned at;
 
+	if (gpu_identity) {
+		pool_give_back(address, size);  /* GPU address = physical: the buffer's pool memory */
+		return;
+	}
 	size = (size + 0xffff) & ~0xffffull;
 	for (at = 0; at < va_free_count && va_free[at].start < address; at++) {
 	}
@@ -814,6 +901,9 @@ redwood_gpu_parameter(uint32_t which, uint64_t *value)
 bool
 redwood_gpu_map(uint64_t address, uint64_t phys, bool read_only)
 {
+	if (gpu_identity) {
+		return true;
+	}
 	return mmu_map(address, phys, read_only);
 }
 
@@ -829,6 +919,9 @@ redwood_gpu_mapped(void)
 void
 redwood_gpu_unmap(uint64_t address, uint64_t size)
 {
+	if (gpu_identity) {
+		return;
+	}
 	for (uint64_t off = 0; off < size; off += 4096) {
 		uint64_t *t = l3_for(address + off, false);
 		if (t != NULL) {
