From f0144e0000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
Subject: [PATCH 0144e] evergo: guard canaries inside the UFS DMA allocation

The device boots deep into userspace and then dies in a different kernel
place on every run - a bad kernel stack pointer in cpu_data, a lock at
address 3, a page-table entry gone - while the same kernel passes the QEMU
gate every time and the SWEET canary pages and the ANOM registry never fire.

QEMU exercises none of this: its root is a memdisk, so not a single UFS DMA
cycle ever runs.  The device, once daemons start pulling in the 1.1 GiB
dyld shared cache, runs thousands of DMA transfers per second.  If the
controller writes even one byte more than the PRDT grants (a transfer-size
or alignment quirk on this MTK host), the overrun lands in the physical
neighbour of the bounce allocation - a random kernel object - which is
exactly the observed signature.

Shrink the usable bounce area a little and place canaries in the bytes it
gives up: one stripe right before the bounce region and one right after
its end.  Check them after every command; on breakage, name the command,
the transfer length and which stripe died (first hit per stripe, then a
running count).  The PRDT still only ever covers the shrunk bounce area,
so a clean run proves the DMA stays inside its grant.

No change to the transfer path itself.
---
diff --git a/bsd/dev/sweet_ufs.c b/bsd/dev/sweet_ufs.c
index b15fc68..4ce3357 100644
--- a/bsd/dev/sweet_ufs.c
+++ b/bsd/dev/sweet_ufs.c
@@ -96,6 +96,14 @@ struct ucd {
 #define DMA_UTRL        0x0000                  /* 1 KiB aligned */
 #define DMA_UCD         0x1000                  /* 128 byte aligned */
 #define DMA_BOUNCE      0x4000
+/*
+ * evergo (0144e): the usable bounce area is BOUNCE_SIZE minus two guard
+ * stripes; the canaries live inside the allocation so an overrun past the
+ * last PRDT byte is caught instead of landing in a random neighbour.
+ */
+#define DMA_CANARY_PRE  (DMA_BOUNCE - 256)      /* stripe before bounce */
+#define DMA_CANARY_POST (DMA_BOUNCE + BOUNCE_SIZE - 512)  /* stripe after */
+#define BOUNCE_USABLE   (BOUNCE_SIZE - 512)
 #define DMA_SIZE        (DMA_BOUNCE + BOUNCE_SIZE)
 
 static struct {
@@ -153,7 +161,7 @@ ufs_scsi(const uint8_t *cdb, unsigned cdb_len, uint32_t len, bool write)
 	struct ucd *ucd = (struct ucd *)(su.dma + DMA_UCD);
 	uint64_t ucd_pa = su.dma_pa + DMA_UCD, bounce_pa = su.dma_pa + DMA_BOUNCE;
 
-	assert(len <= BOUNCE_SIZE);
+	assert(len <= BOUNCE_USABLE);
 	bzero(utrd, sizeof(*utrd));
 	bzero(ucd, sizeof(*ucd));
 
@@ -248,6 +256,60 @@ ufs_scsi(const uint8_t *cdb, unsigned cdb_len, uint32_t len, bool write)
 		dma_sync(DMA_BOUNCE, len);
 	}
 
+#if defined(SWEET)
+	/*
+	 * evergo (0144e): verify the guard stripes after every command.  A
+	 * stripe that changed means the controller wrote outside the PRDT
+	 * grant - the smoking gun for the "random kernel corruption" class.
+	 */
+	{
+		static unsigned int broken_pre, broken_post, clean_runs;
+
+		const volatile uint32_t *pre =
+		    (const volatile uint32_t *)(su.dma + DMA_CANARY_PRE);
+		const volatile uint32_t *post =
+		    (const volatile uint32_t *)(su.dma + DMA_CANARY_POST);
+		unsigned int bad_pre = 0, bad_post = 0;
+
+		for (unsigned int i = 0; i < 256 / 4; i++) {
+			if (pre[i] != 0x5a5a5a5a) {
+				bad_pre++;
+			}
+			if (post[i] != 0x5a5a5a5a) {
+				bad_post++;
+			}
+		}
+		if (bad_pre || bad_post) {
+			if (bad_pre && (broken_pre++ & 0x7) == 0) {
+				printf("SWEET UFS: DMA overran BEFORE the bounce "
+				    "(cmd 0x%02x len %u, %u words bad)\n",
+				    cdb[0], len, bad_pre);
+			}
+			if (bad_post && (broken_post++ & 0x7) == 0) {
+				printf("SWEET UFS: DMA overran AFTER the bounce "
+				    "(cmd 0x%02x len %u, %u words bad)\n",
+				    cdb[0], len, bad_post);
+			}
+			/* repaint so the next command is judged on its own */
+			volatile uint32_t *wp =
+			    (volatile uint32_t *)(su.dma + DMA_CANARY_PRE);
+			volatile uint32_t *wo =
+			    (volatile uint32_t *)(su.dma + DMA_CANARY_POST);
+			for (unsigned int i = 0; i < 256 / 4; i++) {
+				if (bad_pre) {
+					wp[i] = 0x5a5a5a5a;
+				}
+				if (bad_post) {
+					wo[i] = 0x5a5a5a5a;
+				}
+			}
+		} else if ((clean_runs++ & 0xfffff) == 0) {
+			printf("SWEET UFS: canaries intact after %u commands\n",
+			    clean_runs);
+		}
+	}
+#endif
+
 	uint32_t ocs = utrd->dw2 & 0xff;
 	if (ocs || ucd->resp[0] != 0x21 || ucd->resp[6] || ucd->resp[7]) {
 		printf("SWEET UFS: command 0x%02x failed: ocs 0x%x upiu 0x%x response 0x%x status 0x%x\n",
@@ -767,6 +829,22 @@ sweet_ufs_init(void)
 		return ENOMEM;
 	}
 	su.dma_pa = ptoa_64(pn);
+	/*
+	 * evergo (0144e): paint the guard stripes once; ufs_scsi() verifies
+	 * them after every command.  0x5a rows are unmistakable next to the
+	 * controller's own payload.
+	 */
+	{
+		volatile uint32_t *pre =
+		    (volatile uint32_t *)(su.dma + DMA_CANARY_PRE);
+		volatile uint32_t *post =
+		    (volatile uint32_t *)(su.dma + DMA_CANARY_POST);
+		for (unsigned int i = 0; i < 256 / 4; i++) {
+			pre[i] = 0x5a5a5a5a;
+			post[i] = 0x5a5a5a5a;
+		}
+		__builtin_arm_dsb(0xf);
+	}
 	su.lun = 0;
 	su.secsize = DEV_BSIZE;
 	sweet_ufs_mtk_prepare(node);
