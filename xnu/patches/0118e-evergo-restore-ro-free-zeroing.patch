diff --git a/osfmk/kern/zalloc.c b/osfmk/kern/zalloc.c
index 6e4e51e..c56ad41 100644
--- a/osfmk/kern/zalloc.c
+++ b/osfmk/kern/zalloc.c
@@ -6117,15 +6117,19 @@ void
 #if ZSECURITY_CONFIG(READ_ONLY)
 	assert(zone_security_array[zid].z_submap_idx == Z_SUBMAP_IDX_READ_ONLY);
 	/*
-	 * evergo (0115e): SKIP the free-time zeroing. pmap_ro_zone_bzero is
-	 * the prime suspect for the random zeroed structures on this port:
-	 * if it zeroes the wrong page (neighbor element), one legitimate
-	 * free kills a live structure - exactly the Z_ZERO wreckage seen
-	 * since v17 (thread_ro/proc_ro/MAC label, plus plimit/task next
-	 * door). Freed ro elements stay stale until reallocated (Z_ZERO
-	 * re-zeroes on alloc), and the read-only mapping still protects
-	 * them from userland. No data is leaked anywhere.
+	 * evergo (0118e): restore the stock free-time zeroing that 0115e
+	 * removed. There is no zero-on-alloc path in the allocator - Z_ZERO
+	 * is only a hint for the "element modified after free" check in
+	 * zalloc_return() - so skipping this bzero means the next allocation
+	 * of a recycled ro element panics with the previous owner's data
+	 * still in place. That is exactly the v41 on-device panic
+	 * ([threads_ro]: element modified after free, off:0, owner/cred/proc/
+	 * task non-zero, prop_ro NULL): self-inflicted, not a double free.
+	 * If pmap_ro_zone_bzero really does zero a live neighbour, the 0119e
+	 * threads_ro double-free detector records it with both callers
+	 * instead of the zeroing hiding it behind this panic.
 	 */
+	pmap_ro_zone_bzero(zid, (vm_offset_t)addr, 0, esize);
 #else
 	(void)zid;
 	bzero(addr, esize);
