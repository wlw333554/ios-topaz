From 8120cf33a98b9c048ae4c7efcce96ee19da47218 Mon Sep 17 00:00:00 2001
From: x <x@x>
Date: Mon, 19 Oct 2026 15:16:20 +0300
Subject: [PATCH 912/947] topaz-0120: GPU pool chunks mapped through
 IOMemoryDescriptor

---
 iokit/Kernel/arm/TopazAdreno.cpp | 10 +++++++++-
 1 file changed, 9 insertions(+), 1 deletion(-)

diff --git a/iokit/Kernel/arm/TopazAdreno.cpp b/iokit/Kernel/arm/TopazAdreno.cpp
index 48c880c..5c0bec3 100644
--- a/iokit/Kernel/arm/TopazAdreno.cpp
+++ b/iokit/Kernel/arm/TopazAdreno.cpp
@@ -237,8 +237,16 @@ topaz_gpu_pool_alloc(uint64_t size, void **va)
 	}
 	unsigned c = (unsigned)((pa - GPU_POOL_BASE) / GPU_POOL_CHUNK);
 	if (gpu_chunk_va[c] == NULL) {
-		gpu_chunk_va[c] = (uint8_t *)ml_io_map_wcomb((vm_offset_t)(GPU_POOL_BASE + c * GPU_POOL_CHUNK), (vm_size_t)GPU_POOL_CHUNK);
+		/* in the kernel map, not the small IO submap ml_io_map uses (64 MB there failed) */
+		IOMemoryDescriptor *md = IOMemoryDescriptor::withPhysicalAddress(GPU_POOL_BASE + c * GPU_POOL_CHUNK,
+		    GPU_POOL_CHUNK, kIODirectionInOut);
+		IOMemoryMap *map = md != NULL ? md->map(kIOMapWriteCombineCache) : NULL;
+		if (map != NULL) {
+			gpu_chunk_va[c] = (uint8_t *)map->getVirtualAddress();     /* (kept for good, with md) */
+		}
 		if (gpu_chunk_va[c] == NULL) {
+			OSSafeReleaseNULL(map);
+			OSSafeReleaseNULL(md);
 			range_free(pool_free, &pool_free_count, 2048, pa, size);
 			return 0;
 		}
