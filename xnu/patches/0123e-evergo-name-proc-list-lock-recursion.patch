diff --git a/bsd/kern/kern_fork.c b/bsd/kern/kern_fork.c
index 9629bbd..802b11c 100644
--- a/bsd/kern/kern_fork.c
+++ b/bsd/kern/kern_fork.c
@@ -1235,9 +1235,22 @@ proc_spinunlock(proc_t p)
 	lck_spin_unlock(&p->p_slock);
 }
 
+#if defined(ARM64_BOARD_CONFIG_SWEET)
+/*
+ * evergo (0123e): remember the last caller of proc_list_lock(). The v46 boot
+ * died with "Mutex <proc_list_mlock> is unexpectedly owned by thread ...",
+ * the recursive-lock check in lck_mtx_lock, which names the mutex but not the
+ * code that took it twice. One store on an already slow path is enough.
+ */
+void *evergo_proc_list_locker;
+#endif
+
 void
 proc_list_lock(void)
 {
+#if defined(ARM64_BOARD_CONFIG_SWEET)
+	evergo_proc_list_locker = __builtin_return_address(0);
+#endif
 	lck_mtx_lock(&proc_list_mlock);
 }
 
diff --git a/osfmk/kern/lock_mtx.c b/osfmk/kern/lock_mtx.c
index 21c5e26..ddecd0a 100644
--- a/osfmk/kern/lock_mtx.c
+++ b/osfmk/kern/lock_mtx.c
@@ -172,7 +172,18 @@ __abortlike
 static void
 __lck_mtx_owned_panic(lck_mtx_t *lock, thread_t thread)
 {
+#if defined(ARM64_BOARD_CONFIG_SWEET)
+	/*
+	 * evergo (0123e): add the last proc_list_lock() caller to the panic
+	 * text. A recursive lck_mtx_lock() otherwise names only the mutex, and
+	 * the caller is what we need; the address symbolizes offline.
+	 */
+	extern void *evergo_proc_list_locker;
+	panic("Mutex %p is unexpectedly owned by thread %p, "
+	    "last proc_list_lock caller %p", lock, thread, evergo_proc_list_locker);
+#else
 	panic("Mutex %p is unexpectedly owned by thread %p", lock, thread);
+#endif
 }
 
 __abortlike
