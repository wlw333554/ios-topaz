diff --git a/osfmk/kern/zalloc.c b/osfmk/kern/zalloc.c
index c56ad41..0061645 100644
--- a/osfmk/kern/zalloc.c
+++ b/osfmk/kern/zalloc.c
@@ -6106,10 +6106,19 @@ void
 	(zfree)(&zone_array[zid], addr);
 }
 
+/* evergo (0121e): defined next to zalloc_ro_mut(), used here as well. */
+static bool evergo_ro_elem_missing(zone_id_t zid, void *elem,
+    const char *op, void *caller);
+
 void
 (zfree_ro)(zone_id_t zid, void *addr)
 {
 	assert(zid >= ZONE_ID__FIRST_RO && zid <= ZONE_ID__LAST_RO);
+
+	if (evergo_ro_elem_missing(zid, addr, "zfree_ro",
+	    __builtin_return_address(0))) {
+		return;
+	}
 	zone_t zone = zone_by_id(zid);
 	zone_stats_t zstats = zone->z_stats;
 	vm_offset_t esize = zone_ro_size_params[zid].z_elem_size;
@@ -7010,6 +7019,29 @@ zalloc_ro_mut_validate_src(zone_id_t zid, void *elem,
 
 #endif /* ZSECURITY_CONFIG(READ_ONLY) */
 
+/*
+ * evergo (0121e): the ro-zone mutators used to reach zone_require_ro with a
+ * NULL element and panic there ("address not in a ro zone (addr: 0)"). The
+ * panic named the wrong frame: zone_require_ro is out-of-line in this build,
+ * so 0107e's __builtin_return_address(0) pointed inside zone_require_ro
+ * itself and the caller stayed invisible. Catch the NULL here, where RA(0)
+ * is the real caller (zalloc_ro_mut is noinline), print it and skip the
+ * write: one skipped ro field update is much cheaper than losing the boot.
+ */
+static bool
+evergo_ro_elem_missing(zone_id_t zid, void *elem, const char *op, void *caller)
+{
+	if (__probable(elem != NULL)) {
+		return false;
+	}
+
+	printf("SWEET ZRO: %s(NULL) zid %d caller %p - skipping\n",
+	    op, (int)zid, caller);
+	extern void evergo_anom_record(int, void *, void *);
+	evergo_anom_record(5, NULL, caller);
+	return true;
+}
+
 __attribute__((noinline))
 void
 zalloc_ro_mut(zone_id_t zid, void *elem, vm_offset_t offset,
@@ -7017,6 +7049,11 @@ zalloc_ro_mut(zone_id_t zid, void *elem, vm_offset_t offset,
 {
 	assert(zid >= ZONE_ID__FIRST_RO && zid <= ZONE_ID__LAST_RO);
 
+	if (evergo_ro_elem_missing(zid, elem, "zalloc_ro_mut",
+	    __builtin_return_address(0))) {
+		return;
+	}
+
 #if ZSECURITY_CONFIG(READ_ONLY)
 	bool skip_src_check = false;
 
@@ -7052,6 +7089,11 @@ zalloc_ro_mut_atomic(zone_id_t zid, void *elem, vm_offset_t offset,
 {
 	assert(zid >= ZONE_ID__FIRST_RO && zid <= ZONE_ID__LAST_RO);
 
+	if (evergo_ro_elem_missing(zid, elem, "zalloc_ro_mut_atomic",
+	    __builtin_return_address(0))) {
+		return 0;
+	}
+
 #if ZSECURITY_CONFIG(READ_ONLY)
 	value = pmap_ro_zone_atomic_op(zid, (vm_offset_t)elem, offset, op, value);
 #else
@@ -7065,6 +7107,11 @@ void
 zalloc_ro_clear(zone_id_t zid, void *elem, vm_offset_t offset, vm_size_t size)
 {
 	assert(zid >= ZONE_ID__FIRST_RO && zid <= ZONE_ID__LAST_RO);
+
+	if (evergo_ro_elem_missing(zid, elem, "zalloc_ro_clear",
+	    __builtin_return_address(0))) {
+		return;
+	}
 #if ZSECURITY_CONFIG(READ_ONLY)
 	pmap_ro_zone_bzero(zid, (vm_offset_t)elem, offset, size);
 #else
