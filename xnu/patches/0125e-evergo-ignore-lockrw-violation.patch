  */
+/*
+ * evergo (0125e): with boot-arg ignore_bad_lockrw=1, tolerate taking a
+ * non-sleepable RW lock while preemption is still enabled. The v48 boot got
+ * through early userland and then died on this assertion (lock_rw.c:1158).
+ * The violation costs latency - the acquirer or holder can be preempted -
+ * but the lock state itself stays correct, and 0109e already recorded the
+ * caller in the 0106e registry as kind 7 (lockrw), so the code that did it
+ * is still visible if something panics later.
+ */
+static bool
+evergo_lockrw_violation_ignored(void)
+{
+	static int allow = -1;
+
+	if (allow < 0) {
+		uint32_t v = 0;
+
+		(void)PE_parse_boot_argn("ignore_bad_lockrw", &v, sizeof(v));
+		allow = (v != 0) ? 1 : 0;
+	}
+	return allow != 0;
+}
+
 bool
 lck_rw_lock_exclusive_check_contended(
 	lck_rw_t        *lock)
@@ -1111,7 +1135,9 @@ lck_rw_lock_exclusive_check_contended(
 		 */
 		extern void evergo_anom_record(int, void *, void *);
 		evergo_anom_record(7, lock, __builtin_return_address(0));
-		panic("Taking non-sleepable RW lock with preemption enabled\n");
+		if (!evergo_lockrw_violation_ignored()) {
+			panic("Taking non-sleepable RW lock with preemption enabled\n");
+		}
 	}
 
