diff --git a/osfmk/vm/vm_user.c b/osfmk/vm/vm_user.c
index f7603d9..6d4da9e 100644
--- a/osfmk/vm/vm_user.c
+++ b/osfmk/vm/vm_user.c
@@ -124,6 +124,94 @@
 
 #include <san/kasan.h>
 
+/*
+ * evergo (0113e): dyld remaps the shared cache __DATA ranges within its
+ * task (vm_remap from the nested shared region sub-map). On this port the
+ * remapped copies have been observed corrupted in userland (dyld B+tree
+ * erase assertion, NULL loader structures) while the on-disk cache is
+ * byte-perfect. Verify, for the first remaps after boot-arg remapcheck=1,
+ * that the destination content matches the source content.
+ */
+static uint32_t evergo_remapcheck_state;
+
+static bool
+evergo_remapcheck_on(void)
+{
+	if (evergo_remapcheck_state == 0) {
+		uint32_t v = 0;
+		(void)PE_parse_boot_argn("remapcheck", &v, sizeof(v));
+		evergo_remapcheck_state = v ? 2 : 1;
+	}
+	return evergo_remapcheck_state == 2;
+}
+
+static void
+evergo_remap_verify(
+	vm_map_t               map,
+	vm_map_address_t       dst,
+	vm_map_address_t       src,
+	vm_map_size_t          size)
+{
+	vm_map_copy_t  c_dst = VM_MAP_COPY_NULL;
+	vm_map_copy_t  c_src = VM_MAP_COPY_NULL;
+	vm_map_address_t k_dst = 0, k_src = 0;
+	kern_return_t   kr;
+	vm_map_size_t   len = MIN(size, 4 * 4096);
+
+	kr = vm_map_copyin(map, dst, len, FALSE, &c_dst);
+	if (kr != KERN_SUCCESS) {
+		printf("SWEET REMAP: dst copyin failed %d dst 0x%llx
+", kr, (uint64_t)dst);
+		return;
+	}
+	kr = vm_map_copyout(kernel_map, &k_dst, c_dst);
+	if (kr != KERN_SUCCESS) {
+		printf("SWEET REMAP: dst copyout failed %d
+", kr);
+		vm_map_copy_discard(c_dst);
+		return;
+	}
+	kr = vm_map_copyin(map, src, len, FALSE, &c_src);
+	if (kr == KERN_SUCCESS) {
+		kr = vm_map_copyout(kernel_map, &k_src, c_src);
+	}
+	if (kr != KERN_SUCCESS) {
+		printf("SWEET REMAP: src copy failed %d src 0x%llx
+", kr, (uint64_t)src);
+		kmem_free(kernel_map, k_dst, round_page(len));
+		return;
+	}
+	if (memcmp((const void *)(uintptr_t)k_dst,
+	    (const void *)(uintptr_t)k_src, (size_t)len) != 0) {
+		vm_map_size_t o;
+		for (o = 0; o < len; o++) {
+			if (*(uint8_t *)(uintptr_t)(k_dst + o) !=
+			    *(uint8_t *)(uintptr_t)(k_src + o)) {
+				break;
+			}
+		}
+		printf("SWEET REMAP: MISMATCH dst 0x%llx src 0x%llx len 0x%llx "
+		    "first diff at 0x%llx: dst %02x %02x %02x %02x src %02x %02x %02x %02x
+",
+		    (uint64_t)dst, (uint64_t)src, (uint64_t)len, (uint64_t)o,
+		    *(uint8_t *)(uintptr_t)(k_dst + o),
+		    *(uint8_t *)(uintptr_t)(k_dst + o + 1),
+		    *(uint8_t *)(uintptr_t)(k_dst + o + 2),
+		    *(uint8_t *)(uintptr_t)(k_dst + o + 3),
+		    *(uint8_t *)(uintptr_t)(k_src + o),
+		    *(uint8_t *)(uintptr_t)(k_src + o + 1),
+		    *(uint8_t *)(uintptr_t)(k_src + o + 2),
+		    *(uint8_t *)(uintptr_t)(k_src + o + 3));
+	} else {
+		printf("SWEET REMAP: verify OK dst 0x%llx len 0x%llx
+",
+		    (uint64_t)dst, (uint64_t)len);
+	}
+	kmem_free(kernel_map, k_dst, round_page(len));
+	kmem_free(kernel_map, k_src, round_page(len));
+}
+
+
 #include <libkern/OSDebug.h>
 #include <IOKit/IOBSD.h>
 
@@ -1379,6 +1467,16 @@ mach_vm_remap_kernel_helper(
 	if (kr == KERN_SUCCESS && target_map->pmap == kernel_pmap) {
 		kasan_notify_address(*address, size);
 	}
+#endif
+#if defined(ARM64_BOARD_CONFIG_SWEET)
+	if (kr == KERN_SUCCESS && copy && evergo_remapcheck_on()) {
+		static uint32_t evergo_remap_verifies;
+		if (evergo_remap_verifies < 12) {
+			evergo_remap_verifies++;
+			evergo_remap_verify(target_map, *address,
+			    memory_address, size);
+		}
+	}
 #endif
 	return kr;
 }
