-	vm_tag_t                vm_tag)
-{
-	vm_flags ^= (VM_FLAGS_FIXED | VM_FLAGS_ANYWHERE);
-	vmk_flags->__vm_flags &= ~VM_FLAGS_ANY_MASK;
-	vmk_flags->__vm_flags |= (vm_flags & VM_FLAGS_ANY_MASK);
