From d2d0ff9cb84197d7646f8fb1a11dd2dcecf84a45 Mon Sep 17 00:00:00 2001
From: x <x@x>
Date: Tue, 20 Oct 2026 22:23:33 +0300
Subject: [PATCH 927/947] topaz private: only backboardd's screen-sized
 surfaces from the GPU pool (applications' came out black)

---
 iokit/Kernel/arm/SweetSurface.cpp | 10 ++++++++--
 1 file changed, 8 insertions(+), 2 deletions(-)

diff --git a/iokit/Kernel/arm/SweetSurface.cpp b/iokit/Kernel/arm/SweetSurface.cpp
index e0dfeda..bc4d248 100644
--- a/iokit/Kernel/arm/SweetSurface.cpp
+++ b/iokit/Kernel/arm/SweetSurface.cpp
@@ -395,8 +395,14 @@ sweet_gpu_pool_eligible(const SweetSurface *s)
 			gpu = 0;
 		}
 	}
-	return gpu && s->bytesPerElement == 4 && s->planeCount <= 1 && s->elementWidth == 1 && s->elementHeight == 1 &&
-	       s->width >= 1000 && s->height >= 2000 && s->allocSize <= (48u << 20);
+	if (!(gpu && s->bytesPerElement == 4 && s->planeCount <= 1 && s->elementWidth == 1 && s->elementHeight == 1 &&
+	    s->width >= 1000 && s->height >= 2000 && s->allocSize <= (48u << 20))) {
+		return false;
+	}
+	/* only the window server's own (the display's frames); applications' screen-sized surfaces came out black */
+	char name[32];
+	proc_selfname(name, sizeof(name));
+	return strcmp(name, "backboardd") == 0;
 }
 
 static uint32_t
-- 
2.43.0

