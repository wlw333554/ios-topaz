diff --git a/bsd/kern/kern_fork.c b/bsd/kern/kern_fork.c
index 9629bbd..f9664d5 100644
--- a/bsd/kern/kern_fork.c
+++ b/bsd/kern/kern_fork.c
@@ -322,6 +322,20 @@ fork1(proc_t parent_proc, thread_t *child_threadp, int kind, coalition_t *coalit
 
 		/* child_proc = child_thread->task->proc; */
 		child_proc = (proc_t)(get_bsdtask_info(get_threadtask(child_thread)));
+#if defined(ARM64_BOARD_CONFIG_SWEET)
+		/*
+		 * evergo (0129e): a cloneproc() that returns a thread whose task has
+		 * no proc would be dereferenced by proc_ucred() two lines below (the
+		 * v52 data abort at far 0x18). Fail the fork instead of losing the
+		 * kernel, and name the task that came back empty.
+		 */
+		if (__improbable(child_proc == PROC_NULL)) {
+			printf("SWEET FORK: child task %p has no proc, caller %p - EAGAIN\n",
+			    get_threadtask(child_thread), __builtin_return_address(0));
+			err = EAGAIN;
+			goto bad;
+		}
+#endif
 
 		if (!spawn) {
 			/* Copy current thread state into the child thread (only for fork) */
diff --git a/bsd/kern/kern_proc.c b/bsd/kern/kern_proc.c
index 407a18b..b3a00da 100644
--- a/bsd/kern/kern_proc.c
+++ b/bsd/kern/kern_proc.c
@@ -4904,6 +4904,30 @@ proc_ro_alloc(proc_t p, proc_ro_data_t p_data, task_t t, task_ro_data_t t_data)
 	return pr;
 }
 
+#if defined(ARM64_BOARD_CONFIG_SWEET)
+/*
+ * evergo (0129e): give a task back a usable proc_ro.
+ *
+ * With the read-only zone allocator compiled out (0124e), zone_require_ro()
+ * is a no-op, so a task whose bsd_info_ro is already NULL is no longer caught
+ * where it is read: task_pid() dereferences it through proc_ro_task() and the
+ * kernel dies on a data abort at far 0x8 instead. The v52 boot showed that
+ * twice (fork1 -> proc_ucred(NULL), task_pid -> proc_ro_task(NULL)).
+ *
+ * Repair it the way 0095e repairs a missing thread_ro: build a fresh proc_ro
+ * that owns this task (pr_proc stays NULL, so the proc side reports "none")
+ * and install it. The caller then sees a consistent, zeroed ro instead of a
+ * NULL, and the macro that recorded it names the code that got here.
+ */
+proc_ro_t
+evergo_proc_ro_recover(task_t t)
+{
+	struct task_ro_data data = {};
+
+	return proc_ro_alloc(PROC_NULL, NULL, t, &data);
+}
+#endif /* ARM64_BOARD_CONFIG_SWEET */
+
 void
 proc_ro_free(proc_ro_t pr)
 {
@@ -5006,11 +5030,23 @@ current_proc_ro(void)
 proc_t
 proc_ro_proc(proc_ro_t pr)
 {
+#if defined(ARM64_BOARD_CONFIG_SWEET)
+	if (__improbable(pr == NULL)) {
+		return PROC_NULL;
+	}
+#endif
 	return pr->pr_proc;
 }
 
 task_t
 proc_ro_task(proc_ro_t pr)
 {
+#if defined(ARM64_BOARD_CONFIG_SWEET)
+	if (__improbable(pr == NULL)) {
+		printf("SWEET TASK: proc_ro_task(NULL) caller %p\n",
+		    __builtin_return_address(0));
+		return TASK_NULL;
+	}
+#endif
 	return pr->pr_task;
 }
