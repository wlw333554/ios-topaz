diff --git a/bsd/kern/kern_exit.c b/bsd/kern/kern_exit.c
index 8244df1..c9857cb 100644
--- a/bsd/kern/kern_exit.c
+++ b/bsd/kern/kern_exit.c
@@ -860,10 +860,38 @@ get_exception_from_corpse_crashinfo(kcdata_descriptor_t corpse_info)
 {
 	kcdata_iter_t iter = kcdata_iter((void *)corpse_info->kcd_addr_begin,
 	    corpse_info->kcd_length);
+#if defined(ARM64_BOARD_CONFIG_SWEET)
+	/*
+	 * evergo (0130e): a corpse whose crash info does not begin with
+	 * KCDATA_BUFFER_BEGIN_CRASHINFO used to panic here (kern_exit.c:864) and
+	 * took the boot with it - the v53 run died exactly like that while a
+	 * crashed daemon was being reaped. Report what the buffer actually held
+	 * and treat it as a plain crash; the corpse only loses the detail it
+	 * never had.
+	 */
+	uint32_t type = kcdata_iter_valid(iter) ? kcdata_iter_type(iter) : 0;
+
+	if (__improbable(!kcdata_iter_valid(iter) ||
+	    type != KCDATA_BUFFER_BEGIN_CRASHINFO)) {
+		printf("SWEET CORPSE: bad crash info <%u bytes, first type 0x%x>, "
+		    "caller %p - treating as crash\n",
+		    (unsigned int)corpse_info->kcd_length, type,
+		    __builtin_return_address(0));
+		return EXC_CRASH;
+	}
+#else
 	__assert_only uint32_t type = kcdata_iter_type(iter);
 	assert(type == KCDATA_BUFFER_BEGIN_CRASHINFO);
+#endif
 
 	iter = kcdata_iter_find_type(iter, TASK_CRASHINFO_EXCEPTION_TYPE);
+#if defined(ARM64_BOARD_CONFIG_SWEET)
+	if (__improbable(!kcdata_iter_valid(iter))) {
+		printf("SWEET CORPSE: no exception type item, caller %p\n",
+		    __builtin_return_address(0));
+		return EXC_CRASH;
+	}
+#endif
 	exception_type_t *etype = kcdata_iter_payload(iter);
 	return *etype;
 }
