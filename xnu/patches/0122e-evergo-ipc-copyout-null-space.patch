diff --git a/osfmk/ipc/ipc_object.c b/osfmk/ipc/ipc_object.c
index b165c45..5e12f78 100644
--- a/osfmk/ipc/ipc_object.c
+++ b/osfmk/ipc/ipc_object.c
@@ -975,6 +975,23 @@ ipc_object_copyout(
 	assert(IO_VALID(object));
 	assert(io_otype(object) == IOT_PORT);
 
+	/*
+	 * evergo (0122e): never take the space lock on a NULL space. The v44
+	 * on-device run died here while the kernel was tearing down a crashed
+	 * userland process: is_write_lock(space) -> ipc_space_lock(NULL) ->
+	 * lck_ticket_lock(&NULL->is_lock) -> data abort at address 3, which
+	 * killed the machine before launchd could retry the crashed service.
+	 * Refuse the copyout instead and name the caller; a failed port copyout
+	 * only degrades the message, while the abort loses the boot.
+	 */
+	if (__improbable(space == IS_NULL)) {
+		printf("SWEET IPC: copyout with NULL space, caller %p msgt %u\n",
+		    __builtin_return_address(0), (unsigned int)msgt_name);
+		extern void evergo_anom_record(int, void *, void *);
+		evergo_anom_record(3, object, __builtin_return_address(0));
+		return KERN_INVALID_TASK;
+	}
+
 	if (ITH_KNOTE_VALID(kn, msgt_name)) {
 		filt_machport_turnstile_prepare_lazily(kn, msgt_name, port);
 	}
