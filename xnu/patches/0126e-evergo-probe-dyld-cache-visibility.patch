 void
+#if defined(ARM64_BOARD_CONFIG_SWEET)
+/*
+ * evergo (0126e): is the dyld shared cache actually visible through the
+ * mounted root?
+ *
+ * The root volume holds the 25 cache shards as HFS+ hard links: the data
+ * lives in "/.HFS+ Private Data/iNode*" and every visible path under
+ * .../com.apple.dyld/ is a zero-length link record. Whether a process can
+ * read them therefore depends entirely on this port's HFS+ hard-link
+ * resolution. dyld's "Assertion failed: (mapper)" in early userland is
+ * exactly what a zero-length cache looks like from the inside, so print the
+ * size it really gets before launchd starts.
+ */
+static void
+evergo_probe_dsc(void)
+{
+	static const char *const paths[] = {
+		"/System/Library/Caches/com.apple.dyld/dyld_shared_cache_arm64",
+		"/private/preboot/Cryptexes/OS/System/Library/Caches/com.apple.dyld/dyld_shared_cache_arm64",
+		"/System/Library/Caches/com.apple.dyld/dyld_shared_cache_arm64.01",
+		"/usr/lib/dyld",
+		"/var/mobile",
+	};
+	vfs_context_t ctx = vfs_context_kernel();
+
+	for (size_t i = 0; i < sizeof(paths) / sizeof(paths[0]); i++) {
+		vnode_t vp = NULLVP;
+		struct vnode_attr va;
+		int error;
+
+		error = vnode_lookup(paths[i], 0, &vp, ctx);
+		if (error != 0) {
+			printf("SWEET DSC: %s -> lookup error %d\n", paths[i], error);
+			continue;
+		}
+		VATTR_INIT(&va);
+		VATTR_WANTED(&va, va_data_size);
+		VATTR_WANTED(&va, va_mode);
+		VATTR_WANTED(&va, va_fileid);
+		error = vnode_getattr(vp, &va, ctx);
+		if (error != 0) {
+			printf("SWEET DSC: %s -> getattr error %d\n", paths[i], error);
+		} else {
+			printf("SWEET DSC: %s -> size %lld mode 0%o fileid %llu\n",
+			    paths[i], (long long)va.va_data_size, (unsigned int)va.va_mode,
+			    (unsigned long long)va.va_fileid);
+		}
+		vnode_put(vp);
+	}
+}
+#endif /* ARM64_BOARD_CONFIG_SWEET */
+
 bsd_init(void)
 {
 	struct uthread *ut;
@@ -903,6 +955,10 @@ bsd_init(void)
 
 	mountlist.tqh_first->mnt_flag |= MNT_ROOTFS;
 
+#if defined(ARM64_BOARD_CONFIG_SWEET)
+	evergo_probe_dsc();
+#endif
