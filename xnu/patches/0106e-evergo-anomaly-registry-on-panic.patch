diff --git a/osfmk/kern/debug.c b/osfmk/kern/debug.c
index 437adb1..09925ef 100644
--- a/osfmk/kern/debug.c
+++ b/osfmk/kern/debug.c
@@ -83,6 +83,61 @@
 #include <stdarg.h>
 #include <stdatomic.h>
 #include <sys/pgo.h>
+
+/*
+ * evergo (0106e): kernel structures keep turning up freed-and-zeroed on this
+ * port (thread_ro, task proc_ro, MAC labels, IPC ports - the same family
+ * since v19). Each individual check prints once and scrolls away; by panic
+ * time only the teardown wreckage is on screen. Record the FIRST occurrence
+ * of every anomaly kind here and let the panic path print the registry, so
+ * one photograph carries the original crime scene.
+ */
+#define EVERGO_ANOM_KINDS       5
+
+static const char *evergo_anom_names[EVERGO_ANOM_KINDS] = {
+	"tro", "nsr", "maclabel", "ipc", "procro",
+};
+
+static struct {
+	uint64_t        when;
+	void            *ptr;
+	void            *caller;
+	uint32_t        count;
+} evergo_anom[EVERGO_ANOM_KINDS];
+
+void
+evergo_anom_record(int kind, void *ptr, void *caller)
+{
+	if (kind < 0 || kind >= EVERGO_ANOM_KINDS) {
+		return;
+	}
+	if (evergo_anom[kind].count == 0) {
+		evergo_anom[kind].when = mach_absolute_time();
+		evergo_anom[kind].ptr = ptr;
+		evergo_anom[kind].caller = caller;
+	}
+	evergo_anom[kind].count++;
+}
+
+static void
+evergo_anom_dump(void)
+{
+	int k, any = 0;
+
+	for (k = 0; k < EVERGO_ANOM_KINDS; k++) {
+		if (evergo_anom[k].count == 0) {
+			continue;
+		}
+		any = 1;
+		printf("SWEET ANOM: %s first ptr %p caller %p count %u\n",
+		    evergo_anom_names[k], evergo_anom[k].ptr,
+		    evergo_anom[k].caller, evergo_anom[k].count);
+	}
+	if (!any) {
+		printf("SWEET ANOM: none recorded\n");
+	}
+}
+
 #include <console/serial_protos.h>
 #if defined(__arm64__)
 #include <arm64/sweet_early.h>
@@ -1073,6 +1128,13 @@ panic_trap_to_debugger(const char *panic_format_str, va_list *panic_args, unsign
 #pragma clang diagnostic pop
 
 #if defined(SWEET)
+	/*
+	 * evergo (0106e): print the anomaly registry before the panic text -
+	 * the first occurrence of each corruption kind carries the original
+	 * crime scene, the console tail otherwise only shows teardown
+	 * wreckage.
+	 */
+	evergo_anom_dump();
 	/* No CPU/thread/debugger state is required for this first panic copy. */
 	sweet_early_panic(panic_format_str, panic_args);
 #endif
diff --git a/osfmk/kern/task.c b/osfmk/kern/task.c
index 67c5f79..bc774e8 100644
--- a/osfmk/kern/task.c
+++ b/osfmk/kern/task.c
@@ -9076,6 +9076,18 @@ task_get_ro(task_t t)
 {
 	proc_ro_t ro = (proc_ro_t)t->bsd_info_ro;
 
+	#if defined(ARM64_BOARD_CONFIG_SWEET) && MACH_ASSERT
+	if (__improbable(ro == NULL)) {
+		/*
+		 * evergo (0106e): v28 on-device died here - the task's
+		 * bsd_info_ro read as 0 (freed-then-zeroed, same corruption
+		 * family). zone_require_ro panics below; record the original
+		 * scene first so the panic registry carries it.
+		 */
+		extern void evergo_anom_record(int, void *, void *);
+		evergo_anom_record(4, t, __builtin_return_address(0));
+	}
+#endif
 	zone_require_ro(ZONE_ID_PROC_RO, sizeof(struct proc_ro), ro);
 	if (__improbable(proc_ro_task(ro) != t)) {
 		panic_proc_ro_task_backref_mismatch(t, ro);
