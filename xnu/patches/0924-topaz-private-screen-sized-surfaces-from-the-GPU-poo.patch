From a72615ee8cd7f935b834c5fcda5012ab81d11366 Mon Sep 17 00:00:00 2001
From: x <x@x>
Date: Tue, 20 Oct 2026 21:53:46 +0300
Subject: [PATCH 924/947] topaz private: screen-sized surfaces from the GPU
 pool (drawn in place, scanned directly by the MDP); gpu_fbpool=0 turns it off

---
 iokit/Kernel/arm/SweetFramebuffer.cpp |  5 ++-
 iokit/Kernel/arm/SweetSurface.cpp     | 49 +++++++++++++++++++++++++++
 iokit/Kernel/arm/SweetSurface.h       |  3 +-
 iokit/Kernel/arm/TopazAdreno.cpp      |  8 +++++
 4 files changed, 63 insertions(+), 2 deletions(-)

diff --git a/iokit/Kernel/arm/SweetFramebuffer.cpp b/iokit/Kernel/arm/SweetFramebuffer.cpp
index de23813..0a8712a 100644
--- a/iokit/Kernel/arm/SweetFramebuffer.cpp
+++ b/iokit/Kernel/arm/SweetFramebuffer.cpp
@@ -932,7 +932,10 @@ AppleCLCD::directPresent(const uint8_t *rec)
 				 * next frame in this surface at once, so scanning it directly let
 				 * the panel show frames half drawn. Cached to cached, a few ms.
 				 */
-				if (fFlip[0] != NULL) {
+				if (s->gpuPool) {
+					/* GPU pool memory (write-combined): the MDP scans the surface itself, no copy */
+					scanFrom(pa, s->bytesPerRow);
+				} else if (fFlip[0] != NULL) {
 					flipFrom((const uint8_t *)(va + s->offset + (uint64_t)oy * s->bytesPerRow + (uint64_t)ox * 4),
 					    s->bytesPerRow);
 				} else {
diff --git a/iokit/Kernel/arm/SweetSurface.cpp b/iokit/Kernel/arm/SweetSurface.cpp
index c35b578..bafcb07 100644
--- a/iokit/Kernel/arm/SweetSurface.cpp
+++ b/iokit/Kernel/arm/SweetSurface.cpp
@@ -182,6 +182,10 @@ SweetSurface::free()
 	}
 	OSSafeReleaseNULL(kernelMap);
 	OSSafeReleaseNULL(values);
+	if (gpuPool && memory != NULL) {
+		OSSafeReleaseNULL(memory);
+		topaz_gpu_pool_free(scanoutPhys, allocSize);
+	}
 	if (wrapped && memory != NULL) {
 		memory->complete();
 	}
@@ -368,6 +372,32 @@ sweet_dict_u32(OSDictionary *dict, const char *key, uint32_t def)
 
 static IOReturn sweet_surface_use_task_memory(SweetSurface *s, task_t task, uint64_t address, uint64_t size);
 
+/* topaz GPU (TopazAdreno.cpp): the GPU pool below 4 GiB */
+extern "C" uint64_t topaz_gpu_pool_alloc(uint64_t size, void **va);
+extern "C" void topaz_gpu_pool_free(uint64_t pa, uint64_t size);
+extern "C" IOMemoryDescriptor *topaz_gpu_pool_md(uint64_t pa, uint64_t size);
+
+/*
+ * With gpu=1 the screen-sized surfaces come from the GPU pool: contiguous, below 4 GiB,
+ * write-combined. The GPU draws into them in place (no frame copied out by the CPU) and the
+ * MDP scans them directly.
+ */
+static bool
+sweet_gpu_pool_eligible(const SweetSurface *s)
+{
+	static int gpu = -1;
+	if (gpu < 0) {
+		uint32_t on = 0;
+		gpu = PE_parse_boot_argn("gpu", &on, sizeof(on)) && on != 0;
+		uint32_t pool = 1;
+		if (PE_parse_boot_argn("gpu_fbpool", &pool, sizeof(pool)) && pool == 0) {
+			gpu = 0;
+		}
+	}
+	return gpu && s->bytesPerElement == 4 && s->planeCount <= 1 && s->elementWidth == 1 && s->elementHeight == 1 &&
+	       s->width >= 1000 && s->height >= 2000 && s->allocSize <= (48u << 20);
+}
+
 static uint32_t
 sweet_div_up(uint32_t a, uint32_t b)
 {
@@ -860,6 +890,25 @@ IOSurfaceRootUserClient::create(IOExternalMethodArguments *args)
 			    client_address->unsigned64BitValue(), used, s->width, s->height, s->pixelFormat, ret);
 		}
 	}
+	if (ret == kIOReturnSuccess && s->memory == NULL && sweet_gpu_pool_eligible(s)) {
+		void *va = NULL;
+		uint64_t pa = topaz_gpu_pool_alloc(s->allocSize, &va);
+		IOMemoryDescriptor *md = pa != 0 ? topaz_gpu_pool_md(pa, s->allocSize) : NULL;
+		if (md != NULL) {
+			for (uint64_t i = 0; i < s->allocSize; i += 8) {
+				*(volatile uint64_t *)((uint8_t *)va + i) = 0;
+			}
+			s->memory = md;
+			s->gpuPool = true;
+			s->scanoutPhys = pa;
+			s->mapCache = kIOMapDefaultCache;       /* (the descriptor says write-combined) */
+			if (!sweet_surface_publish(s)) {
+				ret = kIOReturnNoResources;
+			}
+		} else if (pa != 0) {
+			topaz_gpu_pool_free(pa, s->allocSize);
+		}
+	}
 	if (ret == kIOReturnSuccess && s->memory == NULL && sweet_scanout_eligible(s)) {
 		int slot = sweet_scanout_alloc_slot();
 		if (slot >= 0) {
diff --git a/iokit/Kernel/arm/SweetSurface.h b/iokit/Kernel/arm/SweetSurface.h
index 5a70fe4..a2991e0 100644
--- a/iokit/Kernel/arm/SweetSurface.h
+++ b/iokit/Kernel/arm/SweetSurface.h
@@ -45,9 +45,10 @@ public:
 	uint32_t                  purgeable;    /* IOSurfaceSetPurgeable state */
 	uint32_t                  wrapDelta;    /* wrapped client memory: where it starts in its first page */
 	bool                      wrapped;      /* memory is a prepared range of a task (IOSurfaceWrapClient*) */
+	bool                      gpuPool;      /* topaz GPU: memory from the GPU pool below 4 GiB (scanoutPhys = its address) */
 	uint32_t                  drawn;        /* topaz GPU: last submission naming this surface (RedwoodGPU.cpp) */
 
-	bool init() APPLE_KEXT_OVERRIDE { scanoutPhys = 0; scanoutSlot = -1; values = NULL; purgeable = 0; wrapDelta = 0; wrapped = false; drawn = 0; return OSObject::init(); }
+	bool init() APPLE_KEXT_OVERRIDE { scanoutPhys = 0; scanoutSlot = -1; values = NULL; purgeable = 0; wrapDelta = 0; wrapped = false; drawn = 0; gpuPool = false; return OSObject::init(); }
 	void free() APPLE_KEXT_OVERRIDE;
 
 	/* Kernel address of the pixels (mapped on first use), or 0. */
diff --git a/iokit/Kernel/arm/TopazAdreno.cpp b/iokit/Kernel/arm/TopazAdreno.cpp
index b7f5330..16da336 100644
--- a/iokit/Kernel/arm/TopazAdreno.cpp
+++ b/iokit/Kernel/arm/TopazAdreno.cpp
@@ -281,6 +281,14 @@ topaz_gpu_pool_alloc(uint64_t size, void **va)
 	return pa;
 }
 
+static void pool_give_back(uint64_t pa, uint64_t size);
+extern "C" void topaz_gpu_pool_free(uint64_t pa, uint64_t size);
+void
+topaz_gpu_pool_free(uint64_t pa, uint64_t size)
+{
+	pool_give_back(pa, size);
+}
+
 static void
 pool_give_back(uint64_t pa, uint64_t size)
 {
-- 
