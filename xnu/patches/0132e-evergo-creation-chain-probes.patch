diff --git a/osfmk/arm/machine_routines_common.c b/osfmk/arm/machine_routines_common.c
index f6bbffd..c97503e 100644
--- a/osfmk/arm/machine_routines_common.c
+++ b/osfmk/arm/machine_routines_common.c
@@ -1062,6 +1062,25 @@ ml_set_interrupts_enabled_with_debug(boolean_t enable, boolean_t __unused debug)
 		if (evergo_cdp == NULL) {
 			evergo_cdp = thread->machine.CpuDatap;
 		}
+		if (evergo_cdp == NULL) {
+			/*
+			 * evergo (0132e): neither the live per-CPU pointer nor the
+			 * thread's cached one exists. Say exactly what we are running
+			 * as: if the magic is gone this is a freed-then-reused thread,
+			 * if getCpuDatap() is NULL the per-CPU base itself is unset.
+			 */
+			static bool evergo_ctx_warned;
+			if (!evergo_ctx_warned) {
+				evergo_ctx_warned = true;
+				printf("SWEET CTX: no CpuDatap at all: live %p thread %p "
+				    "magic 0x%llx ref %d state 0x%x caller %p\n",
+				    (void *)getCpuDatap(), thread,
+				    (unsigned long long)thread->thread_magic,
+				    os_ref_get_count_raw(&thread->ref_count),
+				    (unsigned int)thread->state,
+				    __builtin_return_address(0));
+			}
+		}
 #else
 		assert(getCpuDatap()->cpu_int_state == NULL); // Make sure we're not enabling interrupts from primary interrupt context
 #endif
diff --git a/osfmk/vm/vm_pageout.c b/osfmk/vm/vm_pageout.c
index 7344652..c97f656 100644
--- a/osfmk/vm/vm_pageout.c
+++ b/osfmk/vm/vm_pageout.c
@@ -7681,6 +7681,27 @@ process_upl_to_commit:
 
 	object = upl->map_object;
 
+#if defined(ARM64_BOARD_CONFIG_SWEET)
+	if (__improbable(object == VM_OBJECT_NULL)) {
+		/*
+		 * evergo (0132e): the v55 boot died here with
+		 * lck_rw_lock_exclusive(NULL) <- upl_commit_range, far 0x12: the UPL
+		 * had already lost its map_object. Report which UPL and give up the
+		 * commit instead of taking the lock on a NULL object.
+		 */
+		static bool evergo_upl_warned;
+		if (!evergo_upl_warned) {
+			evergo_upl_warned = true;
+			printf("SWEET UPL: upl %p has NULL map_object (flags 0x%x "
+			    "size 0x%x), caller %p - failing commit\n",
+			    upl, (unsigned int)upl->flags, (unsigned int)upl->u_size,
+			    __builtin_return_address(0));
+		}
+		kr = KERN_FAILURE;
+		goto done;
+	}
+#endif
+
 	if (upl->flags & UPL_SHADOWED) {
 		vm_object_lock(object);
 		shadow_object = object->shadow;
