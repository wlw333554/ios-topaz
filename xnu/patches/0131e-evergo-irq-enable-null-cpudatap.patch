diff --git a/osfmk/arm/machine_routines_common.c b/osfmk/arm/machine_routines_common.c
index a6af1b9..f6bbffd 100644
--- a/osfmk/arm/machine_routines_common.c
+++ b/osfmk/arm/machine_routines_common.c
@@ -1046,7 +1046,25 @@ ml_set_interrupts_enabled_with_debug(boolean_t enable, boolean_t __unused debug)
 	state = __builtin_arm_rsr("DAIF");
 
 	if (enable && (state & DAIF_IRQF)) {
+#if defined(ARM64_BOARD_CONFIG_SWEET)
+		/*
+		 * evergo (0131e): both the assertion below and the urgent-AST drain
+		 * reach for CPU-local state. thread->machine.CpuDatap is only valid
+		 * for a thread that has been switched in (pcb.c clears it on switch
+		 * out), so on this port it can be NULL while interrupts are being
+		 * re-enabled - the v54 boot died exactly there:
+		 *   data abort at ml_set_interrupts_enabled_with_debug+0xec,
+		 *   lr fork1+0x21c, far 0x0.
+		 * Use the live CPU data instead, and drain only when there is one.
+		 */
+		cpu_data_t *evergo_cdp = getCpuDatap();
+
+		if (evergo_cdp == NULL) {
+			evergo_cdp = thread->machine.CpuDatap;
+		}
+#else
 		assert(getCpuDatap()->cpu_int_state == NULL); // Make sure we're not enabling interrupts from primary interrupt context
+#endif
 #if SCHED_HYGIENE_DEBUG
 		if (__probable(debug && (interrupt_masked_debug_mode || sched_preemption_disable_debug_mode))) {
 			// Interrupts are currently masked, we will enable them (after finishing this check)
@@ -1061,7 +1079,12 @@ ml_set_interrupts_enabled_with_debug(boolean_t enable, boolean_t __unused debug)
 		}
 #endif  // SCHED_HYGIENE_DEBUG
 		if (get_preemption_level() == 0) {
+#if defined(ARM64_BOARD_CONFIG_SWEET)
+			while (evergo_cdp != NULL &&
+			    (evergo_cdp->cpu_pending_ast & AST_URGENT)) {
+#else
 			while (thread->machine.CpuDatap->cpu_pending_ast & AST_URGENT) {
+#endif
 #if __ARM_USER_PROTECT__
 				uintptr_t up = arm_user_protect_begin(thread);
 #endif
