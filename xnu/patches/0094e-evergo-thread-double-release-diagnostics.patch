diff --git a/osfmk/kern/thread.c b/osfmk/kern/thread.c
index 384ef23..3b33b66 100644
--- a/osfmk/kern/thread.c
+++ b/osfmk/kern/thread.c
@@ -95,6 +95,13 @@
 #include <machine/pal_routines.h>
 #include <machine/limits.h>
 
+#if defined(ARM64_BOARD_CONFIG_SWEET) && MACH_ASSERT
+#include <libkern/kernel_mach_header.h>
+#include <mach-o/loader.h>
+#include <mach-o/nlist.h>
+#include <pexpert/pexpert.h>
+#endif
+
 #include <kern/kern_types.h>
 #include <kern/kalloc.h>
 #include <kern/cpu_data.h>
@@ -746,6 +753,109 @@ thread_terminate_self(void)
 	/*NOTREACHED*/
 }
 
+#if defined(ARM64_BOARD_CONFIG_SWEET) && MACH_ASSERT
+/*
+ * evergo (0094e): thread_magic is cleared to zero at the end of
+ * thread_deallocate_complete(), so reaching thread_ref_release() with a magic
+ * that is already gone means this thread was released once too often. Upstream
+ * asserts and names only the thread, which does not say who dropped it twice;
+ * on this port that has to be readable off the device screen.
+ *
+ * Resolve the return address to "symbol+offset" from the kernel's own
+ * LC_SYMTAB, the way panic_print_symbol_name() does on x86_64 - on arm64 that
+ * helper is an empty stub, so the lookup rides here. The table is read
+ * defensively: no __LINKEDIT, an implausible symbol count, or no symbol at or
+ * below the target leaves the plain address in the line instead.
+ *
+ * With boot-arg ignore_bad_threadmagic=1 the redundant release is dropped on
+ * the floor and the boot carries on, so the log past this point reaches the
+ * console instead of stopping at the first double free.
+ */
+static int
+evergo_bad_threadmagic_ignored(void)
+{
+	static int allow = -1;
+
+	if (allow < 0) {
+		uint32_t v = 0;
+
+		(void)PE_parse_boot_argn("ignore_bad_threadmagic", &v, sizeof(v));
+		allow = (v != 0) ? 1 : 0;
+	}
+	return allow;
+}
+
+static void
+evergo_symbol_snprintf(char *buf, size_t buflen, void *addr)
+{
+	kernel_mach_header_t     *mh = &_mh_execute_header;
+	struct load_command      *cmd;
+	kernel_segment_command_t *text = NULL;
+	kernel_segment_command_t *linkedit = NULL;
+	struct symtab_command    *st = NULL;
+	kernel_nlist_t           *syms;
+	const char               *strings;
+	const char               *bestname = NULL;
+	uintptr_t                 slide, target, best = 0;
+	uint32_t                  i;
+
+	buf[0] = '\0';
+	if (addr == NULL) {
+		return;
+	}
+
+	cmd = (struct load_command *)(void *)(mh + 1);
+	for (i = 0; i < mh->ncmds; i++) {
+		if (cmd->cmd == LC_SEGMENT_KERNEL) {
+			kernel_segment_command_t *sg = (kernel_segment_command_t *)(void *)cmd;
+
+			if (strncmp(sg->segname, "__TEXT", sizeof(sg->segname)) == 0) {
+				text = sg;
+			} else if (strncmp(sg->segname, "__LINKEDIT", sizeof(sg->segname)) == 0) {
+				linkedit = sg;
+			}
+		} else if (cmd->cmd == LC_SYMTAB) {
+			st = (struct symtab_command *)(void *)cmd;
+		}
+		cmd = (struct load_command *)(void *)((uintptr_t)cmd + cmd->cmdsize);
+	}
+
+	if (text == NULL || linkedit == NULL || st == NULL) {
+		return;
+	}
+	if (st->nsyms == 0 || st->nsyms > (1U << 20) || st->stroff == 0) {
+		return;
+	}
+
+	slide = (uintptr_t)mh - (uintptr_t)text->vmaddr;
+	syms = (kernel_nlist_t *)(uintptr_t)(linkedit->vmaddr + slide + st->symoff - linkedit->fileoff);
+	strings = (const char *)(uintptr_t)(linkedit->vmaddr + slide + st->stroff - linkedit->fileoff);
+	target = (uintptr_t)addr - slide;
+
+	for (i = 0; i < st->nsyms; i++) {
+		uintptr_t value = (uintptr_t)syms[i].n_value;
+
+		if ((syms[i].n_type & N_STAB) != 0 || value == 0) {
+			continue;
+		}
+		if (value > target || value <= best) {
+			continue;
+		}
+		best = value;
+		bestname = strings + syms[i].n_un.n_strx;
+	}
+
+	if (bestname == NULL || bestname[0] == '\0') {
+		return;
+	}
+	if (bestname[0] == '_') {
+		bestname++;
+	}
+	(void)snprintf(buf, buflen, "%s+0x%llx", bestname,
+	    (unsigned long long)(target - best));
+}
+#endif /* ARM64_BOARD_CONFIG_SWEET && MACH_ASSERT */
+
 static bool
 thread_ref_release(thread_t thread)
 {
@@ -753,7 +863,32 @@ thread_ref_release(thread_t thread)
 		return false;
 	}
 
+#if defined(ARM64_BOARD_CONFIG_SWEET) && MACH_ASSERT
+	if (__improbable(thread->thread_magic != THREAD_MAGIC)) {
+		char caller[64];
+
+		evergo_symbol_snprintf(caller, sizeof(caller),
+		    __builtin_return_address(0));
+		printf("SWEET THREAD: double release of thread %p "
+		    "(magic 0x%llx, refcount %d), caller %s (%p)\n",
+		    thread, (unsigned long long)thread->thread_magic,
+		    os_ref_get_count_raw(&thread->ref_count),
+		    caller[0] != '\0' ? caller : "?",
+		    __builtin_return_address(0));
+
+		if (evergo_bad_threadmagic_ignored()) {
+			return false;
+		}
+
+		panic("thread.c:%d Assertion failed: %s : bad thread magic 0x%llx "
+		    "for thread %p, expected 0x%llx", __LINE__,
+		    "(thread)->thread_magic == THREAD_MAGIC",
+		    (unsigned long long)thread->thread_magic, thread,
+		    (unsigned long long)THREAD_MAGIC);
+	}
+#else
 	assert_thread_magic(thread);
+#endif /* ARM64_BOARD_CONFIG_SWEET && MACH_ASSERT */
 
 	return os_ref_release_raw(&thread->ref_count, &thread_refgrp) == 0;
 }
