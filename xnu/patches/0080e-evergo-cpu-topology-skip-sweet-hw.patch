diff --git a/bsd/dev/sweet_ufs.c b/bsd/dev/sweet_ufs.c
index 6b926fe..40044c8 100644
--- a/bsd/dev/sweet_ufs.c
+++ b/bsd/dev/sweet_ufs.c
@@ -656,9 +656,21 @@ sweet_ufs_init(void)
 	    su.writable ? "read-write" : "read-only", su.dma_pa);
 	sweet_log_start();
 	sweet_sample_start();
-	/* Input drivers (HID services in iokit/Kernel/arm/hid/SweetHID.cpp). */
-	sweet_keys_init();
-	sweet_touch_init();
-	sweet_usb_probe();
+	/*
+	 * Input drivers (HID services in iokit/Kernel/arm/hid/SweetHID.cpp).
+	 * They still poke SM7150 MMIO (SPMI, GENI SE7, DWC3 at 0xa600000); on
+	 * evergo (MT6833) that faults or hangs, so they only run with sweethw=1
+	 * until they are ported. evergo's touch is a Novatek NT36672C on the
+	 * MTK SPI1 bus, not a Qualcomm GENI/QUP device.
+	 */
+	int hw = 0;
+	(void)PE_parse_boot_argn("sweethw", &hw, sizeof(hw));
+	if (hw == 1) {
+		sweet_keys_init();
+		sweet_touch_init();
+		sweet_usb_probe();
+	} else {
+		printf("SWEET UFS: keys/touch/USB skipped (evergo, sweethw=0)\n");
+	}
 	return 0;
 }

diff --git a/iokit/Kernel/arm/SweetCPU.cpp b/iokit/Kernel/arm/SweetCPU.cpp
index 2545cf9..1724396 100644
--- a/iokit/Kernel/arm/SweetCPU.cpp
+++ b/iokit/Kernel/arm/SweetCPU.cpp
@@ -73,8 +73,9 @@ SweetCPU::start(IOService *provider)
 	if (*(const uint32_t *)reg->getBytesNoCopy() != cpu->phys_id) {
 		return false;
 	}
-	/* MPIDR Aff1 = core: 0x000-0x500 A55, 0x600/0x700 A76 */
-	if (cpu->phys_id > 0x700 || (cpu->phys_id & 0xff) != 0 ||
+	/* evergo (MT6833): six A55 at MPIDR 0x000-0x005 + two A76 at 0x100-0x101 */
+	if ((cpu->phys_id >> 8) > 1 || (cpu->phys_id & 0xff) > 5 ||
+	    ((cpu->phys_id >> 8) == 1 && (cpu->phys_id & 0xff) > 1) ||
 	    topology->num_cpus > SWEET_SMP_MAX_CPUS) {
 		panic("SWEET CPU: invalid topology cpu=%u mpidr=0x%x count=%u",
 		    cpu->cpu_id, cpu->phys_id, topology->num_cpus);
@@ -82,5 +83,5 @@ SweetCPU::start(IOService *provider)
 	}
 	if (!IOCPU::start(provider)) {
 		return false;
 	}
-	cpuName = OSSymbol::withCStringNoCopy("Kryo 470");
+	cpuName = OSSymbol::withCStringNoCopy("MT6833");

diff --git a/pexpert/pexpert/arm64/SWEET.h b/pexpert/pexpert/arm64/SWEET.h
index b99c2f4..ebf0107 100644
--- a/pexpert/pexpert/arm64/SWEET.h
+++ b/pexpert/pexpert/arm64/SWEET.h
@@ -18,7 +18,10 @@
 #define SWEET                     1
 
 /*
- * All eight cores (six A55 + two A76) as one homogeneous SMP cluster:
+ * All eight cores as one homogeneous SMP cluster (evergo/MT6833: six A55 at
+ * MPIDR 0x0-0x5 + two A76 at 0x100-0x101). Unlike topaz every core here is
+ * ARMv8.2 with the 16K granule, so the MTK LK boot core (CPU0, an A55) runs
+ * xnu directly and all eight cores may start (cpus=8).
  * cpus=N is clamped here. Same ISA level (ARMv8.2), 64-byte lines, PSCI
  * CPU_ON; the scheduler does not know the A76s are faster (no AMP/P-E
  * clusters yet).
