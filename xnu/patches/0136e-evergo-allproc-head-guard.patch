From f0136e0000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
Subject: [PATCH 0136e] evergo: keep a corrupted allproc head from panicking the boot

The v61 boot died in LIST_CHECK_HEAD while inserting a new child:

  SWEET EARLY PANIC: Bad list head 0xfffffe0007bfc778 first->prev != head 0x247
      @kern_proc.c:2417
  panic(cpu 0 caller ...): Bad list head ...

0x247 is not a kernel address, so the first element of allproc is memory that
has already been freed - a proc left linked after it was destroyed, or removed
twice (LIST_REMOVE on a proc that was not on the list rewrites the neighbours'
le_prev).  The canaries were clean again, so this is object lifetime, not
scribbled memory.

Two guards, both only in the SWEET build:

  kern_proc.c  check the head before inserting; if it is already broken, say
               what the head/first/le_prev look like and leave the new child
               out of allproc instead of panicking the whole boot.

  kern_exit.c  only move the proc to zombproc when it really is on allproc,
               so a second removal can no longer corrupt the neighbours.
---
diff --git a/bsd/kern/kern_exit.c b/bsd/kern/kern_exit.c
index c9857cb..3fceb55 100644
--- a/bsd/kern/kern_exit.c
+++ b/bsd/kern/kern_exit.c
@@ -2093,8 +2093,34 @@ skipcheck:
 	proc_memorystatus_remove(p);
 #endif
 
+#if defined(ARM64_BOARD_CONFIG_SWEET)
+	/*
+	 * evergo (0136e): LIST_REMOVE on a proc that is not on allproc rewrites
+	 * the neighbours' le_prev and corrupts the list for the next insert.
+	 * Only move procs that are really on it, and say so when one is not.
+	 */
+	{
+		proc_t scan = PROC_NULL;
+		int on_allproc = 0;
+
+		LIST_FOREACH(scan, &allproc, p_list) {
+			if (scan == p) {
+				on_allproc = 1;
+				break;
+			}
+		}
+		if (__improbable(!on_allproc)) {
+			printf("SWEET EXIT: proc %p (%s) not on allproc - skip move\n",
+			    p, &p->p_name[0]);
+		} else {
+			LIST_REMOVE(p, p_list);
+			LIST_INSERT_HEAD(&zombproc, p, p_list); /* Place onto zombproc. */
+		}
+	}
+#else
 	LIST_REMOVE(p, p_list);
 	LIST_INSERT_HEAD(&zombproc, p, p_list); /* Place onto zombproc. */
+#endif
 	/* will not be visible via proc_find */
 	os_atomic_or(&p->p_refcount, P_REF_DEAD, relaxed);
 
diff --git a/bsd/kern/kern_proc.c b/bsd/kern/kern_proc.c
index b3a00da..8c41a1f 100644
--- a/bsd/kern/kern_proc.c
+++ b/bsd/kern/kern_proc.c
@@ -2414,7 +2414,28 @@ pinsertchild(proc_t parent, proc_t child, bool in_exec)
 	parent->p_childrencnt++;
 	LIST_INSERT_HEAD(&parent->p_children, child, p_sibling);
 
+#if defined(ARM64_BOARD_CONFIG_SWEET)
+	/*
+	 * evergo (0136e): allproc can arrive here with its first element already
+	 * freed (first->le_prev == 0x247 on the v61 boot). Inserting into that
+	 * list corrupts it further and LIST_CHECK_HEAD panics the boot; log what
+	 * the head looks like and keep this child out of allproc instead.
+	 */
+	{
+		proc_t const first = LIST_FIRST(&allproc);
+
+		if (__improbable(first != NULL &&
+		    first->p_list.le_prev != &LIST_FIRST(&allproc))) {
+			printf("SWEET PROC: allproc head bad (head %p first %p prev %p) - "
+			    "leaving %p (%s) out of allproc\n", &allproc, first,
+			    first->p_list.le_prev, child, &child->p_name[0]);
+		} else {
+			LIST_INSERT_HEAD(&allproc, child, p_list);
+		}
+	}
+#else
 	LIST_INSERT_HEAD(&allproc, child, p_list);
+#endif
 	/* mark the completion of proc creation */
 	os_atomic_andnot(&child->p_refcount, P_REF_NEW, relaxed);
 
