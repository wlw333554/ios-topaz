diff --git a/bsd/kern/bsd_init.c b/bsd/kern/bsd_init.c
index 514b2f8..bcf4939 100644
--- a/bsd/kern/bsd_init.c
+++ b/bsd/kern/bsd_init.c
@@ -486,6 +486,16 @@ bsd_rooted_ramdisk(void)
  * exactly what a zero-length cache looks like from the inside, so print the
  * size the kernel really gets before launchd starts.
  */
+/*
+ * evergo (0127e): the cache probe prints once, early, and a panic later in
+ * the boot scrolls it away. Keep the answers in globals so the panic handler
+ * can print them again (see evergo_anom_dump in osfmk/kern/debug.c).
+ */
+int evergo_dsc_count;
+const char *evergo_dsc_path[8];
+long long evergo_dsc_size[8];
+int evergo_dsc_error[8];
+
 static void
 evergo_probe_dsc(void)
 {
@@ -498,7 +508,10 @@ evergo_probe_dsc(void)
 	};
 	vfs_context_t ctx = vfs_context_kernel();
 
-	for (size_t i = 0; i < sizeof(paths) / sizeof(paths[0]); i++) {
+	if (evergo_dsc_count != 0) {
+		return;	/* already probed */
+	}
+	for (size_t i = 0; i < sizeof(paths) / sizeof(paths[0]) && evergo_dsc_count < 8; i++) {
 		vnode_t vp = NULLVP;
 		struct vnode_attr va;
 		int error;
@@ -506,6 +519,10 @@ evergo_probe_dsc(void)
 		error = vnode_lookup(paths[i], 0, &vp, ctx);
 		if (error != 0) {
 			printf("SWEET DSC: %s -> lookup error %d\n", paths[i], error);
+			evergo_dsc_path[evergo_dsc_count] = paths[i];
+			evergo_dsc_size[evergo_dsc_count] = -1;
+			evergo_dsc_error[evergo_dsc_count] = error;
+			evergo_dsc_count++;
 			continue;
 		}
 		VATTR_INIT(&va);
@@ -519,6 +536,10 @@ evergo_probe_dsc(void)
 			printf("SWEET DSC: %s -> size %lld mode 0%o fileid %llu\n",
 			    paths[i], (long long)va.va_data_size, (unsigned int)va.va_mode,
 			    (unsigned long long)va.va_fileid);
+			evergo_dsc_path[evergo_dsc_count] = paths[i];
+			evergo_dsc_size[evergo_dsc_count] = (long long)va.va_data_size;
+			evergo_dsc_error[evergo_dsc_count] = 0;
+			evergo_dsc_count++;
 		}
 		vnode_put(vp);
 	}
diff --git a/osfmk/kern/debug.c b/osfmk/kern/debug.c
index 175d681..7d51deb 100644
--- a/osfmk/kern/debug.c
+++ b/osfmk/kern/debug.c
@@ -137,6 +137,28 @@ evergo_anom_dump(void)
 	if (!any) {
 		printf("SWEET ANOM: none recorded\n");
 	}
+
+#if defined(ARM64_BOARD_CONFIG_SWEET)
+	/*
+	 * evergo (0127e): the dyld shared cache probe only prints once, right
+	 * after the root is mounted; a later panic scrolls it away. Repeat what
+	 * it measured, so every panic screen answers "can dyld read the cache".
+	 */
+	{
+		extern int evergo_dsc_count;
+		extern const char *evergo_dsc_path[8];
+		extern long long evergo_dsc_size[8];
+		extern int evergo_dsc_error[8];
+
+		for (int i = 0; i < evergo_dsc_count && i < 8; i++) {
+			printf("SWEET DSC: %s -> err %d size %lld\n",
+			    evergo_dsc_path[i], evergo_dsc_error[i], evergo_dsc_size[i]);
+		}
+		if (evergo_dsc_count == 0) {
+			printf("SWEET DSC: probe did not run\n");
+		}
+	}
+#endif
 }
 
 #include <console/serial_protos.h>
